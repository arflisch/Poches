<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
	<application android:allowBackup="true" android:icon="@mipmap/appicon" android:roundIcon="@mipmap/appicon_round" android:supportsRtl="true" android:label="Poches"></application>
	<uses-permission android:name="android.permission.VIBRATE" />
	<!-- Investments (Poches Pro): quotes from Yahoo Finance, only after the user turns online quotes on. -->
	<uses-permission android:name="android.permission.INTERNET" />
	<!-- Subscription payment reminders (asked at runtime on Android 13+). -->
	<uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
	<!-- Optional app lock with fingerprint or face unlock. -->
	<uses-permission android:name="android.permission.USE_BIOMETRIC" />
</manifest>
