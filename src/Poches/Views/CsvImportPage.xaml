<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Poches.Views.CsvImportPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:c="clr-namespace:Poches.Controls"
    xmlns:l="clr-namespace:Poches.Localization"
    xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
    xmlns:vm="clr-namespace:Poches.ViewModels"
    x:DataType="vm:CsvImportViewModel"
    ios:Page.ModalPresentationStyle="FormSheet"
    Shell.NavBarIsVisible="False"
    SafeAreaEdges="All"
    Shell.PresentationMode="ModalAnimated">

    <Grid RowDefinitions="Auto,*,Auto">
        <Grid Padding="20,18,20,6" ColumnDefinitions="90,*,90">
            <Label c:Touch.Command="{Binding CancelCommand}" Style="{StaticResource LinkLabel}" Text="{l:Tr Common_Cancel}" />
            <Label Grid.Column="1" Style="{StaticResource PageTitle}" Text="{l:Tr Csv_Title}" />
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20,14,20,24" Spacing="18">
                <Label Style="{StaticResource Secondary}" Text="{l:Tr Csv_Intro}" />
                <Border c:Touch.Command="{Binding PickCommand}" Padding="16,14" Style="{StaticResource Card}">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <VerticalStackLayout Spacing="0" VerticalOptions="Center">
                            <Label Style="{StaticResource Strong}" Text="{l:Tr Csv_Choose}" />
                            <Label IsVisible="{Binding HasFile}" Style="{StaticResource Caption}" Text="{Binding FileText}" />
                        </VerticalStackLayout>
                        <c:IconView
                            Grid.Column="1"
                            Color="{AppThemeBinding Light={StaticResource TextTertiaryLight}, Dark={StaticResource TextTertiaryDark}}"
                            Data="{x:Static c:Icons.ChevronRight}"
                            HeightRequest="16"
                            VerticalOptions="Center"
                            WidthRequest="16" />
                    </Grid>
                </Border>

                <VerticalStackLayout IsVisible="{Binding HasFile}" Spacing="18">
                    <VerticalStackLayout Spacing="8">
                        <Label Style="{StaticResource FieldLabel}" Text="{l:Tr Csv_Columns}" />
                        <Border Padding="14,4" Style="{StaticResource Card}">
                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Mappings}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="vm:CsvFieldMapping">
                                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12" MinimumHeightRequest="44">
                                            <Label Style="{StaticResource Secondary}" Text="{Binding Label}" VerticalOptions="Center" />
                                            <Picker Grid.Column="1" FontSize="14" ItemsSource="{Binding Columns}" SelectedIndex="{Binding SelectedIndex}" VerticalOptions="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </Border>
                        <Label Margin="4,0,0,0" Style="{StaticResource Caption}" Text="{l:Tr Csv_ColumnsHint}" />
                    </VerticalStackLayout>

                    <Border Padding="16,0" Style="{StaticResource Card}">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" MinimumHeightRequest="56">
                            <Label Style="{StaticResource Strong}" Text="{l:Tr Csv_AmountIsNet}" VerticalOptions="Center" />
                            <Switch Grid.Column="1" IsToggled="{Binding AmountIsNet}" OnColor="{StaticResource InvestmentsAccent}" VerticalOptions="Center" />
                        </Grid>
                    </Border>
                    <Label Margin="4,-10,0,0" IsVisible="{Binding IsBelgian}" Style="{StaticResource Caption}" Text="{l:Tr Csv_BelgianWithholding}" />

                    <VerticalStackLayout IsVisible="{Binding IsBelgian}" Spacing="8">
                        <Label Style="{StaticResource FieldLabel}" Text="{l:Tr Csv_NewLinesEnvelope}" />
                        <Border
                            Padding="4"
                            BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceMutedLight}, Dark={StaticResource SurfaceMutedDark}}"
                            StrokeShape="RoundRectangle 16"
                            StrokeThickness="0">
                            <Grid BindableLayout.ItemsSource="{Binding Envelopes}" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="4">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="vm:SelectableOption">
                                        <Grid Grid.Row="{Binding Row}" Grid.Column="{Binding Column}" c:Touch.Command="{Binding SelectCommand}" HeightRequest="40">
                                            <Border Padding="0" IsVisible="{Binding IsSelected}" StrokeShape="RoundRectangle 12" Style="{StaticResource Card}" />
                                            <Label FontFamily="OpenSansSemibold" FontSize="12.5" HorizontalOptions="Center" LineBreakMode="TailTruncation" Opacity="{Binding LabelOpacity}" Text="{Binding Label}" VerticalOptions="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </Grid>
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="8">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Style="{StaticResource FieldLabel}" Text="{l:Tr Csv_Preview}" VerticalOptions="Center" />
                            <ActivityIndicator Grid.Column="1" HeightRequest="18" IsRunning="{Binding IsWorking}" IsVisible="{Binding IsWorking}" WidthRequest="18" />
                        </Grid>
                        <Label Style="{StaticResource Strong}" Text="{Binding Summary}" />
                        <Label IsVisible="{Binding HasForeign}" Style="{StaticResource Caption}" Text="{Binding ForeignNote}" />
                        <Border Padding="14,6" Style="{StaticResource Card}">
                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Preview}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="vm:CsvPreviewRow">
                                        <Grid Padding="0,6" ColumnDefinitions="62,*,Auto" ColumnSpacing="10" RowDefinitions="Auto,Auto">
                                            <Label Grid.RowSpan="2" Style="{StaticResource Caption}" Text="{Binding DateText}" VerticalOptions="Center" />
                                            <Label Grid.Column="1" FontSize="14" LineBreakMode="TailTruncation" Text="{Binding LineText}" />
                                            <HorizontalStackLayout Grid.Row="1" Grid.Column="1" Spacing="6">
                                                <Label Style="{StaticResource Caption}" Text="{Binding KindText}" />
                                                <Label IsVisible="{Binding IsNewLine}" Style="{StaticResource Caption}" Text="{l:Tr Csv_NewLineTag}" TextColor="{StaticResource InvestmentsAccent}" />
                                            </HorizontalStackLayout>
                                            <Label
                                                Grid.RowSpan="2"
                                                Grid.Column="2"
                                                FontSize="13"
                                                HorizontalTextAlignment="End"
                                                MaximumWidthRequest="170"
                                                Text="{Binding DetailText}"
                                                VerticalOptions="Center">
                                                <Label.Triggers>
                                                    <DataTrigger Binding="{Binding IsError}" TargetType="Label" Value="True">
                                                        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource NegativeLight}, Dark={StaticResource NegativeDark}}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsDuplicate}" TargetType="Label" Value="True">
                                                        <Setter Property="Opacity" Value="0.55" />
                                                    </DataTrigger>
                                                </Label.Triggers>
                                            </Label>
                                        </Grid>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </Border>
                        <Label IsVisible="{Binding HasMore}" Style="{StaticResource Caption}" Text="{Binding MoreText}" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <VerticalStackLayout Grid.Row="2" Padding="20,8,20,16" Spacing="10">
            <Label IsVisible="{Binding HasError}" Style="{StaticResource ErrorLabel}" Text="{Binding ErrorMessage}" />
            <Border
                Background="{StaticResource InvestmentsAccentGradient}"
                c:Touch.Command="{Binding ImportCommand}"
                IsEnabled="{Binding CanImport}"
                IsVisible="{Binding HasFile}"
                Style="{StaticResource PrimaryButton}">
                <Label Style="{StaticResource PrimaryButtonText}" Text="{Binding ImportText}" />
            </Border>
        </VerticalStackLayout>
    </Grid>
</ContentPage>
