<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Poches.Views.SubscriptionEditPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:c="clr-namespace:Poches.Controls"
    xmlns:comp="clr-namespace:Poches.Views.Components"
    xmlns:l="clr-namespace:Poches.Localization"
    xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
    xmlns:vm="clr-namespace:Poches.ViewModels"
    x:DataType="vm:SubscriptionEditViewModel"
    ios:Page.ModalPresentationStyle="FormSheet"
    Shell.NavBarIsVisible="False"
    SafeAreaEdges="All"
    Shell.PresentationMode="ModalAnimated">

    <Grid RowDefinitions="Auto,*,Auto">
        <!-- Sheet header -->
        <Grid Padding="20,18,20,6" ColumnDefinitions="90,*,90">
            <Label
                c:Touch.Command="{Binding CancelCommand}"
                Style="{StaticResource LinkLabel}"
                Text="{l:Tr Common_Cancel}" />
            <Label Grid.Column="1" Style="{StaticResource PageTitle}" Text="{Binding Title}" />
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20,14,20,24" Spacing="22">

                <!-- Live preview -->
                <Border
                    BackgroundColor="{Binding Appearance.SoftColor}"
                    HeightRequest="96"
                    HorizontalOptions="Center"
                    StrokeShape="RoundRectangle 32"
                    StrokeThickness="0"
                    WidthRequest="96">
                    <Label
                        FontSize="48"
                        HorizontalOptions="Center"
                        Text="{Binding Appearance.Icon}"
                        VerticalOptions="Center" />
                </Border>

                <VerticalStackLayout Spacing="8">
                    <Label Style="{StaticResource FieldLabel}" Text="{l:Tr Edit_Name}" />
                    <Border Style="{StaticResource InputField}">
                        <Entry
                            MaxLength="40"
                            Placeholder="{l:Tr SubEdit_NamePlaceholder}"
                            ReturnType="Done"
                            Text="{Binding Name}" />
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="8">
                    <Label Style="{StaticResource FieldLabel}" Text="{l:Tr SubEdit_Category}" />
                    <Border
                        Padding="4"
                        BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceMutedLight}, Dark={StaticResource SurfaceMutedDark}}"
                        StrokeShape="RoundRectangle 16"
                        StrokeThickness="0">
                        <Grid
                            BindableLayout.ItemsSource="{Binding Categories}"
                            ColumnDefinitions="*,*,*"
                            RowDefinitions="Auto,Auto"
                            RowSpacing="4">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:SelectableOption">
                                    <Grid
                                        Grid.Row="{Binding Row}"
                                        Grid.Column="{Binding Column}"
                                        c:Touch.Command="{Binding SelectCommand}"
                                        HeightRequest="58">
                                        <Border
                                            Padding="0"
                                            IsVisible="{Binding IsSelected}"
                                            StrokeShape="RoundRectangle 12"
                                            Style="{StaticResource Card}" />
                                        <Label
                                            FontFamily="OpenSansSemibold"
                                            FontSize="12"
                                            HorizontalOptions="Center"
                                            HorizontalTextAlignment="Center"
                                            LineBreakMode="TailTruncation"
                                            MaxLines="2"
                                            Opacity="{Binding LabelOpacity}"
                                            Text="{Binding Label}"
                                            VerticalOptions="Center" />
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </Grid>
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="8">
                    <Label Style="{StaticResource FieldLabel}" Text="{l:Tr SubEdit_Price}" />
                    <Border Style="{StaticResource InputField}">
                        <Grid ColumnDefinitions="*,Auto">
                            <Entry Keyboard="Numeric" Placeholder="{Binding PricePlaceholder}" Text="{Binding PriceText}" />
                            <Label
                                Grid.Column="1"
                                Style="{StaticResource Secondary}"
                                Text="{Binding Currency}"
                                VerticalOptions="Center" />
                        </Grid>
                    </Border>
                    <Label
                        Margin="4,0,0,0"
                        IsVisible="{Binding HasCostHint}"
                        Style="{StaticResource Caption}"
                        Text="{Binding CostHint}" />
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="8">
                    <Label Style="{StaticResource FieldLabel}" Text="{l:Tr SubEdit_BilledEvery}" />
                    <Border
                        Padding="4"
                        BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceMutedLight}, Dark={StaticResource SurfaceMutedDark}}"
                        StrokeShape="RoundRectangle 16"
                        StrokeThickness="0">
                        <Grid BindableLayout.ItemsSource="{Binding Periods}" ColumnDefinitions="*,*,*,*,*">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:SelectableOption">
                                    <Grid Grid.Column="{Binding Column}" c:Touch.Command="{Binding SelectCommand}" HeightRequest="40">
                                        <Border
                                            Padding="0"
                                            IsVisible="{Binding IsSelected}"
                                            StrokeShape="RoundRectangle 12"
                                            Style="{StaticResource Card}" />
                                        <Label
                                            FontFamily="OpenSansSemibold"
                                            FontSize="12"
                                            HorizontalOptions="Center"
                                            LineBreakMode="TailTruncation"
                                            Opacity="{Binding LabelOpacity}"
                                            Text="{Binding Label}"
                                            VerticalOptions="Center" />
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </Grid>
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="8">
                    <Label Style="{StaticResource FieldLabel}" Text="{l:Tr SubEdit_NextPayment}" />
                    <Border Style="{StaticResource InputField}">
                        <Grid ColumnDefinitions="22,*" ColumnSpacing="12">
                            <c:IconView
                                Color="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"
                                Data="{x:Static c:Icons.Calendar}"
                                VerticalOptions="Center" />
                            <DatePicker
                                Grid.Column="1"
                                Date="{Binding NextPayment}"
                                Format="dddd d MMMM yyyy" />
                        </Grid>
                    </Border>
                </VerticalStackLayout>

                <comp:AppearancePicker BindingContext="{Binding Appearance}" />

                <Border
                    Padding="16,14"
                    IsVisible="{Binding IsNew, Converter={StaticResource InvertBool}}"
                    Style="{StaticResource Card}">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <VerticalStackLayout Spacing="0" VerticalOptions="Center">
                            <Label FontSize="15" Style="{StaticResource Strong}" Text="{l:Tr SubEdit_Active}" />
                            <Label Style="{StaticResource Caption}" Text="{l:Tr SubEdit_ActiveHint}" />
                        </VerticalStackLayout>
                        <Switch
                            Grid.Column="1"
                            IsToggled="{Binding IsActive}"
                            OnColor="{Binding Appearance.Color}"
                            VerticalOptions="Center" />
                    </Grid>
                </Border>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Actions -->
        <VerticalStackLayout Grid.Row="2" Padding="20,8,20,16" Spacing="10">
            <Label IsVisible="{Binding HasError}" Style="{StaticResource ErrorLabel}" Text="{Binding ErrorMessage}" />
            <Border
                Background="{StaticResource ChargesAccentGradient}"
                c:Touch.Command="{Binding SaveCommand}"
                Style="{StaticResource PrimaryButton}">
                <Label Style="{StaticResource PrimaryButtonText}" Text="{l:Tr Common_Save}" />
            </Border>
            <Label
                Padding="0,8"
                c:Touch.Command="{Binding DeleteCommand}"
                FontFamily="OpenSansSemibold"
                HorizontalOptions="Center"
                IsVisible="{Binding IsNew, Converter={StaticResource InvertBool}}"
                Text="{l:Tr SubEdit_Delete}"
                TextColor="{AppThemeBinding Light={StaticResource NegativeLight}, Dark={StaticResource NegativeDark}}" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
