<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Poches.Views.HoldingEditPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:c="clr-namespace:Poches.Controls"
    xmlns:comp="clr-namespace:Poches.Views.Components"
    xmlns:l="clr-namespace:Poches.Localization"
    xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
    xmlns:vm="clr-namespace:Poches.ViewModels"
    x:DataType="vm:HoldingEditViewModel"
    ios:Page.ModalPresentationStyle="FormSheet"
    Shell.NavBarIsVisible="False"
    SafeAreaEdges="All"
    Shell.PresentationMode="ModalAnimated">

    <Grid RowDefinitions="Auto,*,Auto">
        <Grid Padding="20,18,20,6" ColumnDefinitions="90,*,90">
            <Label c:Touch.Command="{Binding CancelCommand}" Style="{StaticResource LinkLabel}" Text="{l:Tr Common_Cancel}" />
            <Label Grid.Column="1" Style="{StaticResource PageTitle}" Text="{l:Tr Inv_EditHolding}" />
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20,14,20,24" Spacing="22">
                <VerticalStackLayout Spacing="8">
                    <Label Style="{StaticResource FieldLabel}" Text="{l:Tr Edit_Name}" />
                    <Border Style="{StaticResource InputField}">
                        <Entry IsTextPredictionEnabled="False" MaxLength="80" Placeholder="{l:Tr Inv_NamePlaceholder}" ReturnType="Done" Text="{Binding Name}" />
                    </Border>
                </VerticalStackLayout>

                <comp:SymbolPicker BindingContext="{Binding Search}" />

                <VerticalStackLayout Spacing="8">
                    <Label Style="{StaticResource FieldLabel}" Text="{l:Tr Inv_Type}" />
                    <Border
                        Padding="4"
                        BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceMutedLight}, Dark={StaticResource SurfaceMutedDark}}"
                        StrokeShape="RoundRectangle 16"
                        StrokeThickness="0">
                        <Grid BindableLayout.ItemsSource="{Binding Types}" ColumnDefinitions="*,*,*,*" RowDefinitions="Auto,Auto" RowSpacing="4">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:SelectableOption">
                                    <Grid Grid.Row="{Binding Row}" Grid.Column="{Binding Column}" c:Touch.Command="{Binding SelectCommand}" HeightRequest="58">
                                        <Border Padding="0" IsVisible="{Binding IsSelected}" StrokeShape="RoundRectangle 12" Style="{StaticResource Card}" />
                                        <Label
                                            FontFamily="OpenSansSemibold"
                                            FontSize="11.5"
                                            HorizontalOptions="Center"
                                            HorizontalTextAlignment="Center"
                                            LineBreakMode="TailTruncation"
                                            MaxLines="2"
                                            Opacity="{Binding LabelOpacity}"
                                            Text="{Binding Label}"
                                            VerticalOptions="Center" />
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </Grid>
                    </Border>
                </VerticalStackLayout>

                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <VerticalStackLayout Spacing="8">
                        <Label Style="{StaticResource FieldLabel}" Text="{l:Tr Inv_Account}" />
                        <Border Style="{StaticResource InputField}">
                            <Entry IsTextPredictionEnabled="False" MaxLength="40" Placeholder="{l:Tr Inv_AccountPlaceholder}" Text="{Binding Account}" />
                        </Border>
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="1" Spacing="8">
                        <Label Style="{StaticResource FieldLabel}" Text="{l:Tr Inv_Code}" />
                        <Border Style="{StaticResource InputField}">
                            <Entry IsSpellCheckEnabled="False" IsTextPredictionEnabled="False" MaxLength="24" Placeholder="FR0011871128" Text="{Binding Code}" />
                        </Border>
                    </VerticalStackLayout>
                </Grid>

                <VerticalStackLayout Spacing="8">
                    <Label Style="{StaticResource FieldLabel}" Text="{l:Tr Inv_ManualPrice}" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <Border Style="{StaticResource InputField}">
                            <Grid ColumnDefinitions="*,Auto">
                                <Entry Keyboard="Numeric" Placeholder="0" Text="{Binding ManualPriceText}" />
                                <Label Grid.Column="1" Style="{StaticResource Secondary}" Text="{Binding Currency}" VerticalOptions="Center" />
                            </Grid>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource InputField}">
                            <DatePicker Date="{Binding ManualPriceDate}" Format="d MMM yyyy" />
                        </Border>
                    </Grid>
                    <Label Margin="4,0,0,0" Style="{StaticResource Caption}" Text="{l:Tr Inv_ManualPriceHint}" />
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="8">
                    <Label Style="{StaticResource FieldLabel}" Text="{l:Tr Edit_Color}" />
                    <Border Padding="8,12" Style="{StaticResource Card}">
                        <Grid BindableLayout.ItemsSource="{Binding ColorOptions}" ColumnDefinitions="*,*,*,*,*,*" RowDefinitions="Auto,Auto" RowSpacing="10">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:SelectableOption">
                                    <Grid Grid.Row="{Binding Row}" Grid.Column="{Binding Column}" c:Touch.Command="{Binding SelectCommand}" HeightRequest="46" HorizontalOptions="Center" WidthRequest="46">
                                        <Ellipse IsVisible="{Binding IsSelected}" Stroke="{Binding Color}" StrokeThickness="2.5" />
                                        <Ellipse Fill="{Binding Color}" HeightRequest="34" HorizontalOptions="Center" VerticalOptions="Center" WidthRequest="34" />
                                        <c:IconView Color="White" Data="{x:Static c:Icons.Check}" HeightRequest="18" IsVisible="{Binding IsSelected}" StrokeWidth="2.6" WidthRequest="18" />
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </Grid>
                    </Border>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <VerticalStackLayout Grid.Row="2" Padding="20,8,20,16" Spacing="10">
            <Label IsVisible="{Binding HasError}" Style="{StaticResource ErrorLabel}" Text="{Binding ErrorMessage}" />
            <Border Background="{StaticResource AccentGradient}" c:Touch.Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}">
                <Label Style="{StaticResource PrimaryButtonText}" Text="{l:Tr Common_Save}" />
            </Border>
            <Label
                Padding="0,8"
                c:Touch.Command="{Binding DeleteCommand}"
                FontFamily="OpenSansSemibold"
                HorizontalOptions="Center"
                Text="{l:Tr Inv_DeleteHolding}"
                TextColor="{AppThemeBinding Light={StaticResource NegativeLight}, Dark={StaticResource NegativeDark}}" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
