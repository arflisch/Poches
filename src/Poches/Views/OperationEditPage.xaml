<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Poches.Views.OperationEditPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:c="clr-namespace:Poches.Controls"
    xmlns:comp="clr-namespace:Poches.Views.Components"
    xmlns:l="clr-namespace:Poches.Localization"
    xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
    xmlns:vm="clr-namespace:Poches.ViewModels"
    x:DataType="vm:OperationEditViewModel"
    ios:Page.ModalPresentationStyle="FormSheet"
    Shell.NavBarIsVisible="False"
    SafeAreaEdges="All"
    Shell.PresentationMode="ModalAnimated">

    <Grid RowDefinitions="Auto,*,Auto">
        <Grid Padding="20,18,20,6" ColumnDefinitions="90,*,90">
            <Label c:Touch.Command="{Binding CancelCommand}" Style="{StaticResource LinkLabel}" Text="{l:Tr Common_Cancel}" />
            <Label Grid.Column="1" Style="{StaticResource PageTitle}" Text="{Binding Title}" />
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20,14,20,24" Spacing="22">

                <!-- Line -->
                <VerticalStackLayout Spacing="8">
                    <Label Style="{StaticResource FieldLabel}" Text="{l:Tr Inv_Line}" />
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Holdings}" Spacing="8">
                        <BindableLayout.EmptyView>
                            <Border Padding="16" Style="{StaticResource Card}">
                                <Label Style="{StaticResource Secondary}" Text="{l:Tr Inv_NothingToSell}" />
                            </Border>
                        </BindableLayout.EmptyView>
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:HoldingChoice">
                                <Border Padding="14,10" c:Touch.Command="{Binding SelectCommand}" Style="{StaticResource Card}">
                                    <Grid ColumnDefinitions="14,*,Auto" ColumnSpacing="12">
                                        <Ellipse Fill="{Binding Color}" HeightRequest="12" VerticalOptions="Center" WidthRequest="12" />
                                        <VerticalStackLayout Grid.Column="1" Spacing="0">
                                            <Label LineBreakMode="TailTruncation" Style="{StaticResource Strong}" Text="{Binding Name}" />
                                            <Label LineBreakMode="TailTruncation" Style="{StaticResource Caption}" Text="{Binding Caption}" />
                                        </VerticalStackLayout>
                                        <c:IconView
                                            Grid.Column="2"
                                            Color="{StaticResource Primary}"
                                            Data="{x:Static c:Icons.Check}"
                                            HeightRequest="20"
                                            IsVisible="{Binding IsSelected}"
                                            StrokeWidth="2.6"
                                            VerticalOptions="Center"
                                            WidthRequest="20" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="8">
                    <Label Style="{StaticResource FieldLabel}" Text="{l:Tr Inv_OperationDate}" />
                    <Border Style="{StaticResource InputField}">
                        <Grid ColumnDefinitions="22,*" ColumnSpacing="12">
                            <c:IconView Color="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" Data="{x:Static c:Icons.Calendar}" VerticalOptions="Center" />
                            <DatePicker Grid.Column="1" Date="{Binding Date}" Format="dddd d MMMM yyyy" />
                        </Grid>
                    </Border>
                </VerticalStackLayout>

                <comp:CurrencyFields BindingContext="{Binding CurrencyField}" />

                <!-- Sale -->
                <VerticalStackLayout IsVisible="{Binding IsSale}" Spacing="22">
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <VerticalStackLayout Spacing="8">
                            <Label Style="{StaticResource FieldLabel}" Text="{l:Tr Inv_Quantity}" />
                            <Border Style="{StaticResource InputField}">
                                <Entry Keyboard="Numeric" Placeholder="0" Text="{Binding QuantityText}" />
                            </Border>
                            <Label
                                Margin="4,0,0,0"
                                c:Touch.Command="{Binding SellAllCommand}"
                                FontSize="13"
                                IsVisible="{Binding HasHeld}"
                                Style="{StaticResource InvestmentsLinkLabel}"
                                Text="{Binding HeldText}" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="8">
                            <Label Style="{StaticResource FieldLabel}" Text="{l:Tr Inv_SalePrice}" />
                            <Border Style="{StaticResource InputField}">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Entry Keyboard="Numeric" Placeholder="{Binding PricePlaceholder}" Text="{Binding PriceText}" />
                                    <Label Grid.Column="1" Style="{StaticResource Secondary}" Text="{Binding Currency}" VerticalOptions="Center" />
                                </Grid>
                            </Border>
                        </VerticalStackLayout>
                    </Grid>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <VerticalStackLayout Spacing="8">
                            <Label Style="{StaticResource FieldLabel}" Text="{l:Tr Inv_Fees}" />
                            <Border Style="{StaticResource InputField}">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Entry Keyboard="Numeric" Placeholder="0" Text="{Binding FeesText}" />
                                    <Label Grid.Column="1" Style="{StaticResource Secondary}" Text="{Binding Currency}" VerticalOptions="Center" />
                                </Grid>
                            </Border>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" IsVisible="{Binding ShowTob}" Spacing="8">
                            <Label Style="{StaticResource FieldLabel}" Text="{l:Tr Inv_Tob}" />
                            <Border Style="{StaticResource InputField}">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Entry Keyboard="Numeric" Placeholder="0" Text="{Binding TobText}" />
                                    <Label Grid.Column="1" Style="{StaticResource Secondary}" Text="{Binding Currency}" VerticalOptions="Center" />
                                </Grid>
                            </Border>
                        </VerticalStackLayout>
                    </Grid>
                    <Label Margin="4,-14,0,0" IsVisible="{Binding ShowTob}" Style="{StaticResource Caption}" Text="{Binding TobHint}" />
                </VerticalStackLayout>

                <!-- Dividend -->
                <VerticalStackLayout IsVisible="{Binding IsDividend}" Spacing="22">
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <VerticalStackLayout Spacing="8">
                            <Label Style="{StaticResource FieldLabel}" Text="{l:Tr Inv_Gross}" />
                            <Border Style="{StaticResource InputField}">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Entry Keyboard="Numeric" Placeholder="0" Text="{Binding GrossText}" />
                                    <Label Grid.Column="1" Style="{StaticResource Secondary}" Text="{Binding Currency}" VerticalOptions="Center" />
                                </Grid>
                            </Border>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="8">
                            <Label Style="{StaticResource FieldLabel}" Text="{l:Tr Inv_Withholding}" />
                            <Border Style="{StaticResource InputField}">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Entry Keyboard="Numeric" Placeholder="0" Text="{Binding WithholdingText}" />
                                    <Label Grid.Column="1" Style="{StaticResource Secondary}" Text="{Binding Currency}" VerticalOptions="Center" />
                                </Grid>
                            </Border>
                            <Label
                                Margin="4,0,0,0"
                                c:Touch.Command="{Binding UseBelgianWithholdingCommand}"
                                FontSize="13"
                                IsVisible="{Binding CanUseBelgianWithholding}"
                                Style="{StaticResource InvestmentsLinkLabel}"
                                Text="{l:Tr Inv_UseBelgianWithholding}" />
                        </VerticalStackLayout>
                    </Grid>
                    <Label Margin="4,-14,0,0" Style="{StaticResource Caption}" Text="{l:Tr Inv_WithholdingHint}" />
                </VerticalStackLayout>

                <Label Margin="4,0,0,0" Style="{StaticResource Caption}" Text="{Binding Preview}" />
            </VerticalStackLayout>
        </ScrollView>

        <VerticalStackLayout Grid.Row="2" Padding="20,8,20,16" Spacing="10">
            <Label IsVisible="{Binding HasError}" Style="{StaticResource ErrorLabel}" Text="{Binding ErrorMessage}" />
            <Border Background="{StaticResource InvestmentsAccentGradient}" c:Touch.Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}">
                <Label Style="{StaticResource PrimaryButtonText}" Text="{l:Tr Common_Save}" />
            </Border>
            <Label
                Padding="0,8"
                c:Touch.Command="{Binding DeleteCommand}"
                FontFamily="OpenSansSemibold"
                HorizontalOptions="Center"
                IsVisible="{Binding IsNew, Converter={StaticResource InvertBool}}"
                Text="{l:Tr Inv_DeleteOperation}"
                TextColor="{AppThemeBinding Light={StaticResource NegativeLight}, Dark={StaticResource NegativeDark}}" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
