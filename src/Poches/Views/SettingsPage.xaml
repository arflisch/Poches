<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Poches.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:c="clr-namespace:Poches.Controls"
    xmlns:l="clr-namespace:Poches.Localization"
    xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
    xmlns:vm="clr-namespace:Poches.ViewModels"
    x:DataType="vm:SettingsViewModel"
    ios:Page.ModalPresentationStyle="PageSheet"
    Shell.NavBarIsVisible="False"
    SafeAreaEdges="All"
    Shell.PresentationMode="ModalAnimated">

    <ContentPage.Resources>
        <Style x:Key="RowIcon" TargetType="Border">
            <Setter Property="HeightRequest" Value="36" />
            <Setter Property="WidthRequest" Value="36" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="StrokeThickness" Value="0" />
            <Setter Property="StrokeShape" Value="RoundRectangle 11" />
            <Setter Property="VerticalOptions" Value="Center" />
        </Style>
        <Style x:Key="Row" TargetType="Grid">
            <Setter Property="ColumnDefinitions" Value="36,*,Auto" />
            <Setter Property="ColumnSpacing" Value="14" />
            <Setter Property="Padding" Value="0,12" />
            <Setter Property="MinimumHeightRequest" Value="56" />
        </Style>
        <Style x:Key="RowTitle" TargetType="Label">
            <Setter Property="FontFamily" Value="OpenSansSemibold" />
            <Setter Property="FontSize" Value="15" />
        </Style>
        <Style x:Key="Divider" TargetType="BoxView">
            <Setter Property="HeightRequest" Value="1" />
            <Setter Property="Margin" Value="50,0,0,0" />
            <Setter Property="Color" Value="{AppThemeBinding Light={StaticResource DividerLight}, Dark={StaticResource DividerDark}}" />
        </Style>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*">
        <!-- Sheet header -->
        <Grid Padding="20,18,20,6" ColumnDefinitions="90,*,90">
            <Label
                c:Touch.Command="{Binding CloseCommand}"
                Style="{StaticResource LinkLabel}"
                Text="{l:Tr Common_Close}" />
            <Label Grid.Column="1" Style="{StaticResource PageTitle}" Text="{l:Tr Settings_Title}" />
            <ActivityIndicator
                Grid.Column="2"
                HeightRequest="20"
                HorizontalOptions="End"
                IsRunning="{Binding IsBusy}"
                IsVisible="{Binding IsBusy}"
                WidthRequest="20" />
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20,14,20,32" Spacing="10">

                <!-- Display -->
                <Label Style="{StaticResource FieldLabel}" Text="{l:Tr Settings_Display}" />
                <Border Padding="16,0" Style="{StaticResource Card}">
                    <VerticalStackLayout>
                        <Grid c:Touch.Command="{Binding ChooseLanguageCommand}" Style="{StaticResource Row}">
                            <Border BackgroundColor="#260891B2" Style="{StaticResource RowIcon}">
                                <c:IconView Color="#0891B2" Data="{x:Static c:Icons.Globe}" />
                            </Border>
                            <Label Grid.Column="1" Style="{StaticResource RowTitle}" Text="{l:Tr Settings_Language}" VerticalOptions="Center" />
                            <HorizontalStackLayout Grid.Column="2" Spacing="6" VerticalOptions="Center">
                                <Label Style="{StaticResource Secondary}" Text="{Binding LanguageName}" VerticalOptions="Center" />
                                <c:IconView
                                    Color="{AppThemeBinding Light={StaticResource TextTertiaryLight}, Dark={StaticResource TextTertiaryDark}}"
                                    Data="{x:Static c:Icons.ChevronRight}"
                                    HeightRequest="16"
                                    VerticalOptions="Center"
                                    WidthRequest="16" />
                            </HorizontalStackLayout>
                        </Grid>
                        <BoxView Style="{StaticResource Divider}" />
                        <Grid c:Touch.Command="{Binding ChooseCurrencyCommand}" Style="{StaticResource Row}">
                            <Border BackgroundColor="#26D97706" Style="{StaticResource RowIcon}" Padding="0">
                                <Label
                                    FontFamily="OpenSansSemibold"
                                    FontSize="15"
                                    HorizontalOptions="Center"
                                    Text="€"
                                    TextColor="#D97706"
                                    VerticalOptions="Center" />
                            </Border>
                            <Label Grid.Column="1" Style="{StaticResource RowTitle}" Text="{l:Tr Settings_Currency}" VerticalOptions="Center" />
                            <HorizontalStackLayout Grid.Column="2" Spacing="6" VerticalOptions="Center">
                                <Label Style="{StaticResource Secondary}" Text="{Binding Currency}" VerticalOptions="Center" />
                                <c:IconView
                                    Color="{AppThemeBinding Light={StaticResource TextTertiaryLight}, Dark={StaticResource TextTertiaryDark}}"
                                    Data="{x:Static c:Icons.ChevronRight}"
                                    HeightRequest="16"
                                    VerticalOptions="Center"
                                    WidthRequest="16" />
                            </HorizontalStackLayout>
                        </Grid>
                        <BoxView Style="{StaticResource Divider}" />
                        <Grid Style="{StaticResource Row}">
                            <Border BackgroundColor="#268B5CF6" Style="{StaticResource RowIcon}">
                                <c:IconView Color="#8B5CF6" Data="{x:Static c:Icons.EyeOff}" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="0" VerticalOptions="Center">
                                <Label Style="{StaticResource RowTitle}" Text="{l:Tr Settings_HideAmounts}" />
                                <Label Style="{StaticResource Caption}" Text="{l:Tr Settings_HideAmountsHint}" />
                            </VerticalStackLayout>
                            <Switch Grid.Column="2" IsToggled="{Binding HideAmounts}" VerticalOptions="Center" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Security -->
                <VerticalStackLayout IsVisible="{Binding IsLockSupported}" Spacing="8">
                    <Label Margin="0,14,0,0" Style="{StaticResource FieldLabel}" Text="{l:Tr Settings_SecuritySection}" />
                    <Border Padding="16,0" Style="{StaticResource Card}">
                        <Grid Style="{StaticResource Row}">
                            <Border BackgroundColor="#264F46E5" Style="{StaticResource RowIcon}">
                                <c:IconView Color="#4F46E5" Data="{x:Static c:Icons.Lock}" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="0" VerticalOptions="Center">
                                <Label Style="{StaticResource RowTitle}" Text="{Binding LockTitle}" />
                                <Label Style="{StaticResource Caption}" Text="{Binding LockHint}" />
                            </VerticalStackLayout>
                            <Switch
                                Grid.Column="2"
                                IsEnabled="{Binding CanLock}"
                                IsToggled="{Binding IsLockEnabled}"
                                VerticalOptions="Center" />
                        </Grid>
                    </Border>
                </VerticalStackLayout>

                <!-- Subscriptions -->
                <Label Margin="0,14,0,0" Style="{StaticResource FieldLabel}" Text="{l:Tr Settings_SubscriptionsSection}" />
                <Border Padding="16,0" Style="{StaticResource Card}">
                    <Grid c:Touch.Command="{Binding ChooseReminderCommand}" Style="{StaticResource Row}">
                        <Border BackgroundColor="#26F59E0B" Style="{StaticResource RowIcon}">
                            <c:IconView Color="#D97706" Data="{x:Static c:Icons.Bell}" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="0" VerticalOptions="Center">
                            <Label Style="{StaticResource RowTitle}" Text="{l:Tr Settings_Reminder}" />
                            <Label Style="{StaticResource Caption}" Text="{l:Tr Settings_ReminderHint}" />
                        </VerticalStackLayout>
                        <HorizontalStackLayout Grid.Column="2" Spacing="6" VerticalOptions="Center">
                            <Label Style="{StaticResource Secondary}" Text="{Binding ReminderText}" VerticalOptions="Center" />
                            <c:IconView
                                Color="{AppThemeBinding Light={StaticResource TextTertiaryLight}, Dark={StaticResource TextTertiaryDark}}"
                                Data="{x:Static c:Icons.ChevronRight}"
                                HeightRequest="16"
                                VerticalOptions="Center"
                                WidthRequest="16" />
                        </HorizontalStackLayout>
                    </Grid>
                </Border>

                <!-- Backup -->
                <Label Margin="0,14,0,0" Style="{StaticResource FieldLabel}" Text="{l:Tr Settings_BackupSection}" />
                <Border Padding="16,0" Style="{StaticResource Card}">
                    <VerticalStackLayout>
                        <Grid c:Touch.Command="{Binding BackupCommand}" Style="{StaticResource Row}">
                            <Border BackgroundColor="#2610B981" Style="{StaticResource RowIcon}">
                                <c:IconView Color="#10B981" Data="{x:Static c:Icons.Upload}" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="0" VerticalOptions="Center">
                                <Label Style="{StaticResource RowTitle}" Text="{l:Tr Settings_Backup}" />
                                <Label Style="{StaticResource Caption}" Text="{Binding LastBackupText}" />
                            </VerticalStackLayout>
                            <c:IconView
                                Grid.Column="2"
                                Color="{AppThemeBinding Light={StaticResource TextTertiaryLight}, Dark={StaticResource TextTertiaryDark}}"
                                Data="{x:Static c:Icons.ChevronRight}"
                                HeightRequest="16"
                                VerticalOptions="Center"
                                WidthRequest="16" />
                        </Grid>
                        <BoxView Style="{StaticResource Divider}" />
                        <Grid c:Touch.Command="{Binding RestoreCommand}" Style="{StaticResource Row}">
                            <Border BackgroundColor="#263B82F6" Style="{StaticResource RowIcon}">
                                <c:IconView Color="#3B82F6" Data="{x:Static c:Icons.Download}" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="0" VerticalOptions="Center">
                                <Label Style="{StaticResource RowTitle}" Text="{l:Tr Settings_Restore}" />
                                <Label Style="{StaticResource Caption}" Text="{l:Tr Settings_RestoreHint}" />
                            </VerticalStackLayout>
                            <c:IconView
                                Grid.Column="2"
                                Color="{AppThemeBinding Light={StaticResource TextTertiaryLight}, Dark={StaticResource TextTertiaryDark}}"
                                Data="{x:Static c:Icons.ChevronRight}"
                                HeightRequest="16"
                                VerticalOptions="Center"
                                WidthRequest="16" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>
                <Label
                    Margin="4,2,4,0"
                    IsVisible="{OnPlatform Default=False, iOS=True}"
                    Style="{StaticResource Caption}"
                    Text="{l:Tr Settings_BackupHint}" />
                <Label
                    Margin="4,2,4,0"
                    IsVisible="{OnPlatform Default=False, MacCatalyst=True}"
                    Style="{StaticResource Caption}"
                    Text="{l:Tr Settings_BackupHintMac}" />
                <Label
                    Margin="4,2,4,0"
                    IsVisible="{OnPlatform Default=False, Android=True}"
                    Style="{StaticResource Caption}"
                    Text="{l:Tr Settings_BackupHintAndroid}" />

                <!-- Danger zone -->
                <Label Margin="0,14,0,0" Style="{StaticResource FieldLabel}" Text="{l:Tr Settings_DataSection}" />
                <Border Padding="16,0" Style="{StaticResource Card}">
                    <Grid c:Touch.Command="{Binding DeleteAllCommand}" Style="{StaticResource Row}">
                        <Border BackgroundColor="#26F43F5E" Style="{StaticResource RowIcon}">
                            <c:IconView Color="#F43F5E" Data="{x:Static c:Icons.Trash}" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="0" VerticalOptions="Center">
                            <Label
                                Style="{StaticResource RowTitle}"
                                Text="{l:Tr Settings_DeleteAll}"
                                TextColor="{AppThemeBinding Light={StaticResource NegativeLight}, Dark={StaticResource NegativeDark}}" />
                            <Label Style="{StaticResource Caption}" Text="{l:Tr Settings_DeleteAllHint}" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <Label
                    Margin="0,24,0,0"
                    HorizontalTextAlignment="Center"
                    Style="{StaticResource Caption}"
                    Text="{Binding AppVersion}" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
