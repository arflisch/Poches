<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Poches.Views.InvestmentsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:c="clr-namespace:Poches.Controls"
    xmlns:comp="clr-namespace:Poches.Views.Components"
    xmlns:l="clr-namespace:Poches.Localization"
    xmlns:vm="clr-namespace:Poches.ViewModels"
    x:DataType="vm:InvestmentsViewModel"
    Shell.NavBarIsVisible="False"
    SafeAreaEdges="None">

    <ContentPage.Resources>
        <DataTemplate x:Key="HoldingRow" x:DataType="vm:HoldingItemViewModel">
            <Border Padding="14" c:Touch.Command="{Binding OpenCommand}" Style="{StaticResource Card}">
                <Grid ColumnDefinitions="50,*,Auto" ColumnSpacing="14">
                    <Border
                        BackgroundColor="{Binding SoftColor}"
                        HeightRequest="50"
                        StrokeShape="RoundRectangle 16"
                        StrokeThickness="0"
                        VerticalOptions="Center"
                        WidthRequest="50">
                        <Label FontSize="24" HorizontalOptions="Center" Text="{Binding Icon}" VerticalOptions="Center" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                        <Label LineBreakMode="TailTruncation" Style="{StaticResource Strong}" Text="{Binding Name}" />
                        <Label LineBreakMode="TailTruncation" Style="{StaticResource Caption}" Text="{Binding Subtitle}" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="2" Spacing="0" VerticalOptions="Center">
                        <Label HorizontalTextAlignment="End" Style="{StaticResource Strong}" Text="{Binding ValueText}" />
                        <Label HorizontalTextAlignment="End" Style="{StaticResource Caption}" Text="{Binding GainText}">
                            <Label.Triggers>
                                <DataTrigger Binding="{Binding IsGain}" TargetType="Label" Value="True">
                                    <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource PositiveLight}, Dark={StaticResource PositiveDark}}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsLoss}" TargetType="Label" Value="True">
                                    <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource NegativeLight}, Dark={StaticResource NegativeDark}}" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                        <Label HorizontalTextAlignment="End" Style="{StaticResource Caption}" Text="{Binding WeightText}" />
                    </VerticalStackLayout>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="SegmentOption" x:DataType="vm:SelectableOption">
            <Grid Grid.Row="{Binding Row}" Grid.Column="{Binding Column}" c:Touch.Command="{Binding SelectCommand}" HeightRequest="36">
                <Border Padding="0" IsVisible="{Binding IsSelected}" StrokeShape="RoundRectangle 11" Style="{StaticResource Card}" />
                <Label
                    FontFamily="OpenSansSemibold"
                    FontSize="12"
                    HorizontalOptions="Center"
                    LineBreakMode="TailTruncation"
                    Opacity="{Binding LabelOpacity}"
                    Text="{Binding Label}"
                    VerticalOptions="Center" />
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="ChipOption" x:DataType="vm:SelectableOption">
            <Grid c:Touch.Command="{Binding SelectCommand}" HeightRequest="34" MinimumWidthRequest="56">
                <Border Padding="0" IsVisible="{Binding IsSelected}" StrokeShape="RoundRectangle 11" Style="{StaticResource Card}" />
                <Label
                    Padding="12,0"
                    FontFamily="OpenSansSemibold"
                    FontSize="12.5"
                    HorizontalOptions="Center"
                    Opacity="{Binding LabelOpacity}"
                    Text="{Binding Label}"
                    VerticalOptions="Center" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="SummaryRowTemplate" x:DataType="vm:SummaryRow">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <Label Style="{StaticResource Secondary}" Text="{Binding Label}" VerticalOptions="Center" />
                <Label Grid.Column="1" Style="{StaticResource Strong}" Text="{Binding Value}" VerticalOptions="Center">
                    <Label.Triggers>
                        <DataTrigger Binding="{Binding Emphasis}" TargetType="Label" Value="True">
                            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource InvestmentsAccent}, Dark={StaticResource InvestmentsAccentDarkMode}}" />
                        </DataTrigger>
                    </Label.Triggers>
                </Label>
            </Grid>
        </DataTemplate>
    </ContentPage.Resources>

    <Grid SafeAreaEdges="Container,Container,Container,None" Style="{StaticResource PageColumn}">
        <ScrollView SafeAreaEdges="None">
            <VerticalStackLayout Padding="20,12,20,180" Spacing="22">

                <!-- Header -->
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                    <VerticalStackLayout Spacing="0" VerticalOptions="Center">
                        <Label Style="{StaticResource Caption}" Text="{Binding TodayText}" />
                        <Label Style="{StaticResource LargeTitle}" Text="{l:Tr Inv_Title}" />
                    </VerticalStackLayout>
                    <Border
                        Grid.Column="1"
                        c:Touch.Command="{Binding OpenSettingsCommand}"
                        Style="{StaticResource IconButton}"
                        VerticalOptions="Center"
                        SemanticProperties.Description="{l:Tr Main_Settings}">
                        <c:IconView Color="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" Data="{x:Static c:Icons.Settings}" />
                    </Border>
                </Grid>

                <!-- Poches Pro -->
                <Border IsVisible="{Binding IsLocked}" Padding="24,28" Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="12">
                        <Label FontSize="52" HorizontalOptions="Center" Text="📈" />
                        <Border HorizontalOptions="Center" Style="{StaticResource ProBadge}">
                            <Label Style="{StaticResource ProBadgeText}" Text="PRO" />
                        </Border>
                        <Label HorizontalTextAlignment="Center" Style="{StaticResource SectionTitle}" Text="{l:Tr Inv_LockedTitle}" />
                        <Label HorizontalTextAlignment="Center" Style="{StaticResource Secondary}" Text="{l:Tr Inv_LockedText}" />
                        <Border Margin="0,10,0,0" c:Touch.Command="{Binding OpenProCommand}" Background="{StaticResource InvestmentsAccentGradient}" Style="{StaticResource PrimaryButton}">
                            <Label Style="{StaticResource PrimaryButtonText}" Text="{l:Tr Inv_DiscoverPro}" />
                        </Border>
                    </VerticalStackLayout>
                </Border>

                <c:TwoPane IsVisible="{Binding IsUnlocked}" Spacing="22">
                    <c:TwoPane.Start>
                        <VerticalStackLayout Spacing="22">
                            <!-- Value -->
                            <Border
                                Background="{StaticResource InvestmentsGradient}"
                                Shadow="{StaticResource InvestmentsShadow}"
                                StrokeShape="RoundRectangle 28"
                                StrokeThickness="0">
                                <Grid>
                                    <Ellipse
                                        Margin="0,-110,-80,0"
                                        Fill="#1AFFFFFF"
                                        HeightRequest="240"
                                        HorizontalOptions="End"
                                        VerticalOptions="Start"
                                        WidthRequest="240" />
                                    <VerticalStackLayout Padding="24,22,24,20" Spacing="4">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <Label FontSize="15" Text="{l:Tr Inv_CurrentValue}" TextColor="{StaticResource WhiteSoft}" VerticalOptions="Center" />
                                            <Border
                                                Grid.Column="1"
                                                Padding="7"
                                                c:Touch.Command="{Binding TogglePrivacyCommand}"
                                                BackgroundColor="{StaticResource WhiteGlass}"
                                                HeightRequest="34"
                                                StrokeShape="RoundRectangle 17"
                                                StrokeThickness="0"
                                                WidthRequest="34"
                                                SemanticProperties.Description="{l:Tr Main_TogglePrivacy}">
                                                <c:IconView Color="White" Data="{Binding PrivacyIcon}" />
                                            </Border>
                                        </Grid>
                                        <Label LineBreakMode="NoWrap">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span FontFamily="OpenSansSemibold" FontSize="22" Text="{Binding ValuePrefix}" TextColor="{StaticResource WhiteSoft}" />
                                                    <Span FontFamily="OpenSansSemibold" FontSize="42" Text="{Binding ValueWhole}" TextColor="White" />
                                                    <Span FontFamily="OpenSansSemibold" FontSize="22" Text="{Binding ValueFraction}" TextColor="{StaticResource WhiteSoft}" />
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>
                                        <Label FontSize="13" Text="{Binding InvestedText}" TextColor="{StaticResource WhiteSoft}" />
                                        <Label FontSize="13" IsVisible="{Binding HasExtras}" Text="{Binding ExtrasText}" TextColor="{StaticResource WhiteSoft}" />
                                        <Border
                                            Margin="0,8,0,0"
                                            Padding="12,5"
                                            BackgroundColor="{StaticResource WhiteGlass}"
                                            HorizontalOptions="Start"
                                            StrokeShape="RoundRectangle 14"
                                            StrokeThickness="0">
                                            <Label FontFamily="OpenSansSemibold" FontSize="13" Text="{Binding GainText}" TextColor="White" />
                                        </Border>
                                        <VerticalStackLayout Margin="0,12,0,0" Spacing="12">
                                            <BoxView HeightRequest="1" Color="#33FFFFFF" />
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                                <Label FontSize="13" Text="{Binding XirrText}" TextColor="White" VerticalOptions="Center" />
                                                <Label
                                                    Grid.Column="1"
                                                    FontSize="13"
                                                    IsVisible="{Binding HasDayChange}"
                                                    Text="{Binding DayText}"
                                                    TextColor="{StaticResource WhiteSoft}"
                                                    VerticalOptions="Center" />
                                            </Grid>
                                        </VerticalStackLayout>
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>

                            <!-- Online quotes -->
                            <Border Padding="16,14" Style="{StaticResource Card}">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" RowDefinitions="Auto,Auto">
                                    <VerticalStackLayout c:Touch.Command="{Binding ToggleOnlineCommand}" Spacing="0" VerticalOptions="Center">
                                        <Label FontSize="15" Style="{StaticResource Strong}" Text="{l:Tr Inv_OnlineQuotes}" />
                                        <Label Style="{StaticResource Caption}" Text="{Binding QuotesText}" />
                                    </VerticalStackLayout>
                                    <Grid Grid.Column="1" c:Touch.Command="{Binding ToggleOnlineCommand}">
                                        <Switch InputTransparent="True" IsToggled="{Binding OnlineQuotes, Mode=OneWay}" OnColor="{StaticResource InvestmentsAccent}" VerticalOptions="Center" />
                                    </Grid>
                                    <Label
                                        Grid.Row="1"
                                        Padding="0,8,0,0"
                                        c:Touch.Command="{Binding RefreshCommand}"
                                        IsVisible="{Binding OnlineQuotes}"
                                        Style="{StaticResource InvestmentsLinkLabel}"
                                        Text="{l:Tr Inv_Refresh}" />
                                </Grid>
                            </Border>

                            <!-- Dividends found in the quotes -->
                            <Border c:Touch.Command="{Binding OpenDetectedCommand}" IsVisible="{Binding HasDetected}" Padding="16,14" Style="{StaticResource Card}">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                    <Label FontSize="24" Text="💶" VerticalOptions="Center" />
                                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                        <Label Style="{StaticResource Strong}" Text="{l:Tr Inv_DetectedTitle}" />
                                        <Label Style="{StaticResource Caption}" Text="{Binding DetectedText}" />
                                    </VerticalStackLayout>
                                    <c:IconView
                                        Grid.Column="2"
                                        Color="{AppThemeBinding Light={StaticResource TextTertiaryLight}, Dark={StaticResource TextTertiaryDark}}"
                                        Data="{x:Static c:Icons.ChevronRight}"
                                        HeightRequest="16"
                                        VerticalOptions="Center"
                                        WidthRequest="16" />
                                </Grid>
                            </Border>

                            <!-- Empty state -->
                            <Border IsVisible="{Binding IsEmpty}" Padding="24,28" Style="{StaticResource Card}">
                                <VerticalStackLayout Spacing="12">
                                    <Label FontSize="52" HorizontalOptions="Center" Text="📈" />
                                    <Label HorizontalTextAlignment="Center" Style="{StaticResource SectionTitle}" Text="{l:Tr Inv_EmptyTitle}" />
                                    <Label HorizontalTextAlignment="Center" Style="{StaticResource Secondary}" Text="{l:Tr Inv_EmptyText}" />
                                    <Border Margin="0,10,0,0" c:Touch.Command="{Binding AddPurchaseCommand}" Background="{StaticResource InvestmentsAccentGradient}" Style="{StaticResource PrimaryButton}">
                                        <Label Style="{StaticResource PrimaryButtonText}" Text="{l:Tr Inv_AddFirst}" />
                                    </Border>
                                    <Label
                                        Padding="0,6"
                                        c:Touch.Command="{Binding ImportCsvCommand}"
                                        HorizontalOptions="Center"
                                        Style="{StaticResource InvestmentsLinkLabel}"
                                        Text="{l:Tr Csv_Title}" />
                                    <Label
                                        Padding="0,6"
                                        c:Touch.Command="{Binding LoadSamplesCommand}"
                                        HorizontalOptions="Center"
                                        Style="{StaticResource InvestmentsLinkLabel}"
                                        Text="{l:Tr Main_ExploreSamples}" />
                                </VerticalStackLayout>
                            </Border>

                            <!-- Evolution -->
                            <Border IsVisible="{Binding HasEvolution}" Style="{StaticResource Card}">
                                <VerticalStackLayout Spacing="12">
                                    <Label Style="{StaticResource SectionTitle}" Text="{l:Tr Inv_Evolution}" />
                                    <FlexLayout Wrap="Wrap">
                                        <HorizontalStackLayout Margin="0,0,14,4" Spacing="6">
                                            <BoxView CornerRadius="1" HeightRequest="3" VerticalOptions="Center" WidthRequest="14" Color="{AppThemeBinding Light={StaticResource InvestmentsAccent}, Dark={StaticResource InvestmentsAccentDarkMode}}" />
                                            <Label Style="{StaticResource Caption}" Text="{l:Tr Inv_LegendValue}" />
                                        </HorizontalStackLayout>
                                        <HorizontalStackLayout Margin="0,0,14,4" IsVisible="{Binding HasBenchmarkLegend}" Spacing="6">
                                            <BoxView CornerRadius="1" HeightRequest="3" VerticalOptions="Center" WidthRequest="14" Color="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDarkMode}}" />
                                            <Label Style="{StaticResource Caption}" Text="{Binding BenchmarkLegend}" />
                                        </HorizontalStackLayout>
                                        <HorizontalStackLayout Margin="0,0,14,4" Spacing="6">
                                            <BoxView HeightRequest="1.5" VerticalOptions="Center" WidthRequest="14" Color="{AppThemeBinding Light={StaticResource TextTertiaryLight}, Dark={StaticResource TextTertiaryDark}}" />
                                            <Label Style="{StaticResource Caption}" Text="{l:Tr Inv_LegendInvested}" />
                                        </HorizontalStackLayout>
                                    </FlexLayout>
                                    <c:EvolutionChartView
                                        BenchmarkColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDarkMode}}"
                                        GridColor="{AppThemeBinding Light={StaticResource DividerLight}, Dark={StaticResource DividerDark}}"
                                        HeightRequest="200"
                                        InvestedColor="{AppThemeBinding Light={StaticResource TextTertiaryLight}, Dark={StaticResource TextTertiaryDark}}"
                                        LabelColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"
                                        LabelFormatter="{Binding AxisFormatter}"
                                        Points="{Binding Evolution}"
                                        ValueColor="{AppThemeBinding Light={StaticResource InvestmentsAccent}, Dark={StaticResource InvestmentsAccentDarkMode}}" />
                                    <Label Style="{StaticResource Secondary}" Text="{Binding EvolutionText}" />
                                    <Label Style="{StaticResource FieldLabel}" Text="{l:Tr Inv_CompareWith}" />
                                    <Border
                                        Padding="4"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceMutedLight}, Dark={StaticResource SurfaceMutedDark}}"
                                        StrokeShape="RoundRectangle 14"
                                        StrokeThickness="0">
                                        <Grid
                                            BindableLayout.ItemTemplate="{StaticResource SegmentOption}"
                                            BindableLayout.ItemsSource="{Binding Benchmarks}"
                                            ColumnDefinitions="*,*,*"
                                            RowDefinitions="Auto,Auto"
                                            RowSpacing="4" />
                                    </Border>
                                </VerticalStackLayout>
                            </Border>

                            <!-- Returns by period -->
                            <Border IsVisible="{Binding HasPeriods}" Style="{StaticResource Card}">
                                <VerticalStackLayout Spacing="12">
                                    <Label Style="{StaticResource SectionTitle}" Text="{l:Tr Inv_Periods}" />
                                    <ScrollView HorizontalScrollBarVisibility="Never" Orientation="Horizontal">
                                        <Border
                                            Padding="4"
                                            BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceMutedLight}, Dark={StaticResource SurfaceMutedDark}}"
                                            HorizontalOptions="Start"
                                            StrokeShape="RoundRectangle 14"
                                            StrokeThickness="0">
                                            <HorizontalStackLayout BindableLayout.ItemTemplate="{StaticResource ChipOption}" BindableLayout.ItemsSource="{Binding PeriodOptions}" Spacing="2" />
                                        </Border>
                                    </ScrollView>
                                    <Label FontFamily="OpenSansSemibold" FontSize="30" Text="{Binding PeriodReturn}">
                                        <Label.Triggers>
                                            <DataTrigger Binding="{Binding PeriodIsGain}" TargetType="Label" Value="True">
                                                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource PositiveLight}, Dark={StaticResource PositiveDark}}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding PeriodIsLoss}" TargetType="Label" Value="True">
                                                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource NegativeLight}, Dark={StaticResource NegativeDark}}" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                    <Label Margin="0,-8,0,0" Style="{StaticResource Secondary}" Text="{Binding PeriodDetail}" />
                                    <Label IsVisible="{Binding HasPeriodBenchmark}" Style="{StaticResource Caption}" Text="{Binding PeriodBenchmark}" />
                                    <Label Style="{StaticResource Caption}" Text="{l:Tr Inv_PeriodsHint}" />
                                </VerticalStackLayout>
                            </Border>

                            <!-- Plan and goal -->
                            <Border IsVisible="{Binding HasHoldings}" Style="{StaticResource Card}">
                                <VerticalStackLayout Spacing="12">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Label Style="{StaticResource SectionTitle}" Text="{l:Tr Inv_PlanTitle}" VerticalOptions="Center" />
                                        <Label Grid.Column="1" c:Touch.Command="{Binding EditPlanCommand}" Style="{StaticResource InvestmentsLinkLabel}" Text="{l:Tr Common_Edit}" VerticalOptions="Center" />
                                    </Grid>
                                    <Label Style="{StaticResource Secondary}" Text="{Binding PlanText}" />
                                    <Label Style="{StaticResource Strong}" Text="{Binding GoalText}" />
                                    <VerticalStackLayout IsVisible="{Binding HasGoal}" Spacing="4">
                                        <ProgressBar Progress="{Binding GoalProgress}" ProgressColor="{AppThemeBinding Light={StaticResource InvestmentsAccent}, Dark={StaticResource InvestmentsAccentDarkMode}}" />
                                        <Label Style="{StaticResource Caption}" Text="{Binding GoalProgressText}" />
                                    </VerticalStackLayout>
                                    <VerticalStackLayout IsVisible="{Binding HasProjection}" Spacing="8">
                                        <c:ProjectionChartView
                                            Bands="{Binding Projection}"
                                            Goal="{Binding GoalValue}"
                                            GoalColor="{AppThemeBinding Light={StaticResource TextTertiaryLight}, Dark={StaticResource TextTertiaryDark}}"
                                            GridColor="{AppThemeBinding Light={StaticResource DividerLight}, Dark={StaticResource DividerDark}}"
                                            HeightRequest="180"
                                            LabelColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"
                                            LabelFormatter="{Binding AxisFormatter}"
                                            LineColor="{AppThemeBinding Light={StaticResource InvestmentsAccent}, Dark={StaticResource InvestmentsAccentDarkMode}}" />
                                        <Label Style="{StaticResource Secondary}" Text="{Binding ProjectionText}" />
                                        <Label IsVisible="{Binding HasProbability}" Style="{StaticResource Strong}" Text="{Binding ProbabilityText}" />
                                        <Label Style="{StaticResource Caption}" Text="{l:Tr Inv_ProjectionHint}" />
                                    </VerticalStackLayout>
                                    <VerticalStackLayout IsVisible="{Binding HasTargets}" Spacing="4">
                                        <Label Style="{StaticResource Caption}" Text="{Binding DriftText}" />
                                        <Label c:Touch.Command="{Binding OpenContributionCommand}" Style="{StaticResource InvestmentsLinkLabel}" Text="{l:Tr Inv_ContributionTitle}" />
                                    </VerticalStackLayout>
                                </VerticalStackLayout>
                            </Border>
                        </VerticalStackLayout>
                    </c:TwoPane.Start>
                    <c:TwoPane.End>
                        <VerticalStackLayout IsVisible="{Binding HasHoldings}" Spacing="22">
                            <!-- Allocation -->
                            <VerticalStackLayout Spacing="12">
                                <Border
                                    Padding="4"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceMutedLight}, Dark={StaticResource SurfaceMutedDark}}"
                                    StrokeShape="RoundRectangle 14"
                                    StrokeThickness="0">
                                    <Grid
                                        BindableLayout.ItemTemplate="{StaticResource SegmentOption}"
                                        BindableLayout.ItemsSource="{Binding AllocationModes}"
                                        ColumnDefinitions="*,*" />
                                </Border>
                                <comp:BreakdownCard />
                            </VerticalStackLayout>

                            <!-- Lines -->
                            <VerticalStackLayout Spacing="12">
                                <Label Style="{StaticResource SectionTitle}" Text="{l:Tr Inv_Lines}" />
                                <VerticalStackLayout
                                    BindableLayout.ItemTemplate="{StaticResource HoldingRow}"
                                    BindableLayout.ItemsSource="{Binding Holdings}"
                                    Spacing="12" />
                            </VerticalStackLayout>

                            <!-- Belgian tax -->
                            <Border IsVisible="{Binding ShowTax}" Style="{StaticResource Card}">
                                <VerticalStackLayout Spacing="12">
                                    <Label Style="{StaticResource SectionTitle}" Text="{l:Tr Tax_Title}" />
                                    <ScrollView HorizontalScrollBarVisibility="Never" Orientation="Horizontal">
                                        <Border
                                            Padding="4"
                                            BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceMutedLight}, Dark={StaticResource SurfaceMutedDark}}"
                                            HorizontalOptions="Start"
                                            StrokeShape="RoundRectangle 14"
                                            StrokeThickness="0">
                                            <HorizontalStackLayout BindableLayout.ItemTemplate="{StaticResource ChipOption}" BindableLayout.ItemsSource="{Binding TaxYears}" Spacing="2" />
                                        </Border>
                                    </ScrollView>
                                    <VerticalStackLayout BindableLayout.ItemTemplate="{StaticResource SummaryRowTemplate}" BindableLayout.ItemsSource="{Binding TaxRows}" Spacing="10" />
                                    <Label Style="{StaticResource Caption}" Text="{Binding TaxNote}" />
                                </VerticalStackLayout>
                            </Border>

                            <!-- What the money is in -->
                            <Border IsVisible="{Binding HasExposure}" Style="{StaticResource Card}">
                                <VerticalStackLayout Spacing="12">
                                    <Label Style="{StaticResource SectionTitle}" Text="{l:Tr Exposure_Title}" />
                                    <ScrollView HorizontalScrollBarVisibility="Never" Orientation="Horizontal">
                                        <Border
                                            Padding="4"
                                            BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceMutedLight}, Dark={StaticResource SurfaceMutedDark}}"
                                            HorizontalOptions="Start"
                                            StrokeShape="RoundRectangle 14"
                                            StrokeThickness="0">
                                            <HorizontalStackLayout BindableLayout.ItemTemplate="{StaticResource ChipOption}" BindableLayout.ItemsSource="{Binding ExposureModes}" Spacing="2" />
                                        </Border>
                                    </ScrollView>
                                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding ExposureRows}" Spacing="10">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate x:DataType="vm:ExposureRow">
                                                <VerticalStackLayout Spacing="4">
                                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                                        <Label FontSize="13.5" LineBreakMode="TailTruncation" Text="{Binding Name}" />
                                                        <Label Grid.Column="1" FontFamily="OpenSansSemibold" FontSize="13.5" Text="{Binding PercentText}" />
                                                    </Grid>
                                                    <ProgressBar Progress="{Binding Weight}" ProgressColor="{Binding Color}" />
                                                </VerticalStackLayout>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </VerticalStackLayout>
                                    <Label Style="{StaticResource Strong}" Text="{Binding TerText}" />
                                    <Label IsVisible="{Binding HasExposureNote}" Style="{StaticResource Caption}" Text="{Binding ExposureNote}" />
                                    <Label Style="{StaticResource Caption}" Text="{l:Tr Exposure_Source}" />
                                </VerticalStackLayout>
                            </Border>

                            <!-- Sold out -->
                            <VerticalStackLayout IsVisible="{Binding HasClosed}" Spacing="12">
                                <Label Style="{StaticResource SectionTitle}" Text="{l:Tr Inv_ClosedLines}" />
                                <VerticalStackLayout
                                    BindableLayout.ItemTemplate="{StaticResource HoldingRow}"
                                    BindableLayout.ItemsSource="{Binding ClosedHoldings}"
                                    Spacing="12" />
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </c:TwoPane.End>
                </c:TwoPane>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Floating button, as on the other tabs -->
        <Grid CascadeInputTransparent="False" InputTransparent="True" SafeAreaEdges="Container">
            <Border
                Margin="0,0,20,20"
                Padding="22,0"
                c:Touch.Command="{Binding AddOperationCommand}"
                Background="{StaticResource InvestmentsAccentGradient}"
                HeightRequest="58"
                HorizontalOptions="End"
                IsVisible="{Binding HasHoldings}"
                Shadow="{StaticResource InvestmentsShadow}"
                StrokeShape="RoundRectangle 29"
                StrokeThickness="0"
                VerticalOptions="End"
                SemanticProperties.Description="{l:Tr Inv_AddOperation}">
                <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                    <c:IconView Color="White" Data="{x:Static c:Icons.Plus}" HeightRequest="22" StrokeWidth="2.4" VerticalOptions="Center" WidthRequest="22" />
                    <Label FontFamily="OpenSansSemibold" FontSize="16" Text="{l:Tr Inv_AddOperation}" TextColor="White" VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
