<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Poches.Views.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:c="clr-namespace:Poches.Controls"
    xmlns:comp="clr-namespace:Poches.Views.Components"
    xmlns:l="clr-namespace:Poches.Localization"
    xmlns:vm="clr-namespace:Poches.ViewModels"
    x:DataType="vm:MainViewModel"
    Shell.NavBarIsVisible="False"
    SafeAreaEdges="None">

    <!-- Top, left and right stay clear of the notch; the list scrolls under the home indicator. -->
    <Grid SafeAreaEdges="Container,Container,Container,None" Style="{StaticResource PageColumn}">
        <ScrollView SafeAreaEdges="None">
            <VerticalStackLayout Padding="20,12,20,180" Spacing="22">

                <!-- Header -->
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                    <VerticalStackLayout Spacing="0" VerticalOptions="Center">
                        <Label Style="{StaticResource Caption}" Text="{Binding TodayText}" />
                        <Label Style="{StaticResource LargeTitle}" Text="{l:Tr Main_Title}" />
                    </VerticalStackLayout>
                    <Border
                        Grid.Column="1"
                        c:Touch.Command="{Binding OpenSettingsCommand}"
                        Style="{StaticResource IconButton}"
                        VerticalOptions="Center"
                        SemanticProperties.Description="{l:Tr Main_Settings}">
                        <c:IconView Color="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" Data="{x:Static c:Icons.Settings}" />
                    </Border>
                </Grid>

                <!-- Phone: one block above the other. iPad or wide window: side by side. -->
                <c:TwoPane Spacing="22">
                    <c:TwoPane.Start>
                        <VerticalStackLayout Spacing="22">
                            <!-- Total balance -->
                            <Border
                                Background="{StaticResource HeroGradient}"
                                Shadow="{StaticResource FloatingShadow}"
                                StrokeShape="RoundRectangle 28"
                                StrokeThickness="0">
                                <Grid>
                                    <Ellipse
                                        Margin="0,-110,-80,0"
                                        Fill="#1AFFFFFF"
                                        HeightRequest="240"
                                        HorizontalOptions="End"
                                        VerticalOptions="Start"
                                        WidthRequest="240" />
                                    <Ellipse
                                        Margin="-60,0,0,-80"
                                        Fill="#12FFFFFF"
                                        HeightRequest="170"
                                        HorizontalOptions="Start"
                                        VerticalOptions="End"
                                        WidthRequest="170" />

                                    <VerticalStackLayout Padding="24,22,24,24" Spacing="4">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <Label
                                                FontSize="15"
                                                Text="{l:Tr Main_TotalBalance}"
                                                TextColor="{StaticResource WhiteSoft}"
                                                VerticalOptions="Center" />
                                            <Border
                                                Grid.Column="1"
                                                Padding="7"
                                                c:Touch.Command="{Binding TogglePrivacyCommand}"
                                                BackgroundColor="{StaticResource WhiteGlass}"
                                                HeightRequest="34"
                                                StrokeShape="RoundRectangle 17"
                                                StrokeThickness="0"
                                                WidthRequest="34"
                                                SemanticProperties.Description="{l:Tr Main_TogglePrivacy}">
                                                <c:IconView Color="White" Data="{Binding PrivacyIcon}" />
                                            </Border>
                                        </Grid>

                                        <Label LineBreakMode="NoWrap">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span
                                                        FontFamily="OpenSansSemibold"
                                                        FontSize="22"
                                                        Text="{Binding TotalPrefix}"
                                                        TextColor="{StaticResource WhiteSoft}" />
                                                    <Span
                                                        FontFamily="OpenSansSemibold"
                                                        FontSize="42"
                                                        Text="{Binding TotalWhole}"
                                                        TextColor="White" />
                                                    <Span
                                                        FontFamily="OpenSansSemibold"
                                                        FontSize="22"
                                                        Text="{Binding TotalFraction}"
                                                        TextColor="{StaticResource WhiteSoft}" />
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>

                                        <Border
                                            Margin="0,6,0,0"
                                            Padding="12,5"
                                            BackgroundColor="{StaticResource WhiteGlass}"
                                            HorizontalOptions="Start"
                                            IsVisible="{Binding HasMonthDelta}"
                                            StrokeShape="RoundRectangle 14"
                                            StrokeThickness="0">
                                            <Label
                                                FontFamily="OpenSansSemibold"
                                                FontSize="13"
                                                Text="{Binding MonthDeltaText}"
                                                TextColor="White" />
                                        </Border>
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>

                            <!-- Poches Pro shortcuts -->
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="12" IsVisible="{Binding HasPockets}">
                                <Border Padding="14,12" c:Touch.Command="{Binding SplitIncomeCommand}" Style="{StaticResource Card}">
                                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="6">
                                        <Label FontSize="22" Text="💶" />
                                        <Border Grid.Column="1" IsVisible="{Binding IsProLocked}" Style="{StaticResource ProBadge}">
                                            <Label Style="{StaticResource ProBadgeText}" />
                                        </Border>
                                        <Label
                                            Grid.Row="1"
                                            Grid.ColumnSpan="2"
                                            FontSize="14"
                                            Style="{StaticResource Strong}"
                                            Text="{l:Tr Main_Split}" />
                                    </Grid>
                                </Border>
                                <Border
                                    Grid.Column="1"
                                    Padding="14,12"
                                    c:Touch.Command="{Binding OpenStatisticsCommand}"
                                    Style="{StaticResource Card}">
                                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="6">
                                        <Label FontSize="22" Text="📈" />
                                        <Border Grid.Column="1" IsVisible="{Binding IsProLocked}" Style="{StaticResource ProBadge}">
                                            <Label Style="{StaticResource ProBadgeText}" />
                                        </Border>
                                        <Label
                                            Grid.Row="1"
                                            Grid.ColumnSpan="2"
                                            FontSize="14"
                                            Style="{StaticResource Strong}"
                                            Text="{l:Tr Pro_StatsTitle}" />
                                    </Grid>
                                </Border>
                            </Grid>

                            <!-- Backup reminder -->
                            <Border
                                Padding="14"
                                c:Touch.Command="{Binding BackupNowCommand}"
                                IsVisible="{Binding ShowBackupReminder}"
                                Style="{StaticResource Card}">
                                <Grid ColumnDefinitions="40,*,Auto" ColumnSpacing="12">
                                    <Border
                                        Padding="9"
                                        BackgroundColor="#2610B981"
                                        HeightRequest="40"
                                        StrokeShape="RoundRectangle 13"
                                        StrokeThickness="0"
                                        WidthRequest="40">
                                        <c:IconView Color="#10B981" Data="{x:Static c:Icons.Upload}" />
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                        <Label FontSize="15" Style="{StaticResource Strong}" Text="{l:Tr Main_BackupTitle}" />
                                        <Label Style="{StaticResource Caption}" Text="{Binding BackupReminderText}" />
                                    </VerticalStackLayout>
                                    <c:IconView
                                        Grid.Column="2"
                                        Color="{AppThemeBinding Light={StaticResource TextTertiaryLight}, Dark={StaticResource TextTertiaryDark}}"
                                        Data="{x:Static c:Icons.ChevronRight}"
                                        HeightRequest="18"
                                        VerticalOptions="Center"
                                        WidthRequest="18" />
                                </Grid>
                            </Border>

                            <!-- Empty state -->
                            <Border IsVisible="{Binding IsEmpty}" Style="{StaticResource Card}" Padding="24,28">
                                <VerticalStackLayout Spacing="12">
                                    <Label FontSize="52" HorizontalOptions="Center" Text="👛" />
                                    <Label
                                        HorizontalTextAlignment="Center"
                                        Style="{StaticResource SectionTitle}"
                                        Text="{l:Tr Main_EmptyTitle}" />
                                    <Label
                                        HorizontalTextAlignment="Center"
                                        Style="{StaticResource Secondary}"
                                        Text="{l:Tr Main_EmptyText}" />
                                    <Border
                                        Margin="0,10,0,0"
                                        c:Touch.Command="{Binding AddPocketCommand}"
                                        Style="{StaticResource PrimaryButton}">
                                        <Label Style="{StaticResource PrimaryButtonText}" Text="{l:Tr Main_CreateFirst}" />
                                    </Border>
                                    <Label
                                        Padding="0,6"
                                        c:Touch.Command="{Binding LoadSamplesCommand}"
                                        HorizontalOptions="Center"
                                        Style="{StaticResource LinkLabel}"
                                        Text="{l:Tr Main_ExploreSamples}" />
                                </VerticalStackLayout>
                            </Border>

                            <!-- Distribution chart -->
                            <comp:BreakdownCard IsVisible="{Binding HasChart}" />
                        </VerticalStackLayout>
                    </c:TwoPane.Start>
                    <c:TwoPane.End>
                        <VerticalStackLayout Spacing="22" IsVisible="{Binding HasPockets}">
                            <!-- Pockets -->
                            <VerticalStackLayout IsVisible="{Binding HasPockets}" Spacing="12">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Style="{StaticResource SectionTitle}" Text="{l:Tr Main_Title}" VerticalOptions="Center" />
                                    <Label
                                        Grid.Column="1"
                                        Padding="8,6"
                                        c:Touch.Command="{Binding AddPocketCommand}"
                                        Style="{StaticResource LinkLabel}"
                                        Text="{l:Tr Main_NewPocket}" />
                                </Grid>

                                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Pockets}" Spacing="12">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="vm:PocketItemViewModel">
                                            <Border
                                                Padding="14"
                                                c:Touch.Command="{Binding OpenCommand}"
                                                Style="{StaticResource Card}">
                                                <Grid ColumnDefinitions="50,*,Auto" ColumnSpacing="14">
                                                    <Border
                                                        BackgroundColor="{Binding SoftColor}"
                                                        HeightRequest="50"
                                                        StrokeShape="RoundRectangle 16"
                                                        StrokeThickness="0"
                                                        VerticalOptions="Center"
                                                        WidthRequest="50">
                                                        <Label
                                                            FontSize="24"
                                                            HorizontalOptions="Center"
                                                            Text="{Binding Icon}"
                                                            VerticalOptions="Center" />
                                                    </Border>

                                                    <VerticalStackLayout Grid.Column="1" Spacing="5" VerticalOptions="Center">
                                                        <Label
                                                            LineBreakMode="TailTruncation"
                                                            Style="{StaticResource Strong}"
                                                            Text="{Binding Name}" />
                                                        <c:ProgressPill
                                                            FillColor="{Binding Color}"
                                                            HeightRequest="6"
                                                            IsVisible="{Binding HasGoal}"
                                                            Progress="{Binding GoalProgress}"
                                                            TrackColor="{Binding SoftColor}" />
                                                        <Label Style="{StaticResource Caption}" Text="{Binding Caption}" />
                                                    </VerticalStackLayout>

                                                    <Label
                                                        Grid.Column="2"
                                                        HorizontalTextAlignment="End"
                                                        Style="{StaticResource Strong}"
                                                        Text="{Binding BalanceText}"
                                                        VerticalOptions="Center" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </c:TwoPane.End>
                </c:TwoPane>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Floating action button, kept above the home indicator while the list scrolls beneath it -->
        <Grid
            CascadeInputTransparent="False"
            InputTransparent="True"
            SafeAreaEdges="Container">
            <Border
                Margin="0,0,20,20"
                Padding="22,0"
                c:Touch.Command="{Binding AddMovementCommand}"
                Background="{StaticResource AccentGradient}"
                HeightRequest="58"
                HorizontalOptions="End"
                IsVisible="{Binding HasPockets}"
                Shadow="{StaticResource FloatingShadow}"
                StrokeShape="RoundRectangle 29"
                StrokeThickness="0"
                VerticalOptions="End"
                SemanticProperties.Description="{l:Tr Main_AddMoney}">
                <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                    <c:IconView
                        Color="White"
                        Data="{x:Static c:Icons.Plus}"
                        HeightRequest="22"
                        StrokeWidth="2.4"
                        VerticalOptions="Center"
                        WidthRequest="22" />
                    <Label
                        FontFamily="OpenSansSemibold"
                        FontSize="16"
                        Text="{l:Tr Main_Add}"
                        TextColor="White"
                        VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
