<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Poches.Views.SubscriptionsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:c="clr-namespace:Poches.Controls"
    xmlns:comp="clr-namespace:Poches.Views.Components"
    xmlns:l="clr-namespace:Poches.Localization"
    xmlns:vm="clr-namespace:Poches.ViewModels"
    x:DataType="vm:SubscriptionsViewModel"
    Shell.NavBarIsVisible="False"
    SafeAreaEdges="None">

    <ContentPage.Resources>
        <DataTemplate x:Key="SubscriptionRow" x:DataType="vm:SubscriptionItemViewModel">
            <Border
                Padding="14"
                c:Touch.Command="{Binding OpenCommand}"
                Opacity="{Binding RowOpacity}"
                Style="{StaticResource Card}">
                <Grid ColumnDefinitions="50,*,Auto" ColumnSpacing="14">
                    <Border
                        BackgroundColor="{Binding SoftColor}"
                        HeightRequest="50"
                        StrokeShape="RoundRectangle 16"
                        StrokeThickness="0"
                        VerticalOptions="Center"
                        WidthRequest="50">
                        <Label
                            FontSize="24"
                            HorizontalOptions="Center"
                            Text="{Binding Icon}"
                            VerticalOptions="Center" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                        <Label
                            LineBreakMode="TailTruncation"
                            Style="{StaticResource Strong}"
                            Text="{Binding Name}" />
                        <Label Style="{StaticResource Caption}" Text="{Binding Subtitle}">
                            <Label.Triggers>
                                <DataTrigger
                                    Binding="{Binding IsDueSoon}"
                                    TargetType="Label"
                                    Value="True">
                                    <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource DueSoonLight}, Dark={StaticResource DueSoonDark}}" />
                                    <Setter Property="FontFamily" Value="OpenSansSemibold" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="2" Spacing="0" VerticalOptions="Center">
                        <Label
                            HorizontalTextAlignment="End"
                            Style="{StaticResource Strong}"
                            Text="{Binding AmountText}" />
                        <Label
                            HorizontalTextAlignment="End"
                            Style="{StaticResource Caption}"
                            Text="{Binding PeriodText}" />
                    </VerticalStackLayout>
                </Grid>
            </Border>
        </DataTemplate>
    </ContentPage.Resources>

    <!-- Top, left and right stay clear of the notch; the list scrolls under the tab bar. -->
    <Grid SafeAreaEdges="Container,Container,Container,None" Style="{StaticResource PageColumn}">
        <ScrollView SafeAreaEdges="None">
            <VerticalStackLayout Padding="20,12,20,120" Spacing="22">

                <!-- Header -->
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                    <VerticalStackLayout Spacing="0" VerticalOptions="Center">
                        <Label Style="{StaticResource Caption}" Text="{Binding TodayText}" />
                        <Label Style="{StaticResource LargeTitle}" Text="{l:Tr Subs_Title}" />
                    </VerticalStackLayout>
                    <Border
                        Grid.Column="1"
                        c:Touch.Command="{Binding AddSubscriptionCommand}"
                        Style="{StaticResource IconButton}"
                        VerticalOptions="Center"
                        SemanticProperties.Description="{l:Tr Subs_AddFirst}">
                        <c:IconView
                            Color="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}"
                            Data="{x:Static c:Icons.Plus}"
                            StrokeWidth="2.2" />
                    </Border>
                    <Border
                        Grid.Column="2"
                        c:Touch.Command="{Binding OpenSettingsCommand}"
                        Style="{StaticResource IconButton}"
                        VerticalOptions="Center"
                        SemanticProperties.Description="{l:Tr Main_Settings}">
                        <c:IconView Color="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" Data="{x:Static c:Icons.Settings}" />
                    </Border>
                </Grid>

                <!-- Monthly cost -->
                <Border
                    Background="{StaticResource SubscriptionsGradient}"
                    Shadow="{StaticResource FloatingShadow}"
                    StrokeShape="RoundRectangle 28"
                    StrokeThickness="0">
                    <Grid>
                        <Ellipse
                            Margin="0,-110,-80,0"
                            Fill="#1AFFFFFF"
                            HeightRequest="240"
                            HorizontalOptions="End"
                            VerticalOptions="Start"
                            WidthRequest="240" />

                        <VerticalStackLayout Padding="24,22,24,20" Spacing="4">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label
                                    FontSize="15"
                                    Text="{l:Tr Subs_PerMonth}"
                                    TextColor="{StaticResource WhiteSoft}"
                                    VerticalOptions="Center" />
                                <Border
                                    Grid.Column="1"
                                    Padding="7"
                                    c:Touch.Command="{Binding TogglePrivacyCommand}"
                                    BackgroundColor="{StaticResource WhiteGlass}"
                                    HeightRequest="34"
                                    StrokeShape="RoundRectangle 17"
                                    StrokeThickness="0"
                                    WidthRequest="34"
                                    SemanticProperties.Description="{l:Tr Main_TogglePrivacy}">
                                    <c:IconView Color="White" Data="{Binding PrivacyIcon}" />
                                </Border>
                            </Grid>

                            <Label LineBreakMode="NoWrap">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span
                                            FontFamily="OpenSansSemibold"
                                            FontSize="22"
                                            Text="{Binding MonthlyPrefix}"
                                            TextColor="{StaticResource WhiteSoft}" />
                                        <Span
                                            FontFamily="OpenSansSemibold"
                                            FontSize="42"
                                            Text="{Binding MonthlyWhole}"
                                            TextColor="White" />
                                        <Span
                                            FontFamily="OpenSansSemibold"
                                            FontSize="22"
                                            Text="{Binding MonthlyFraction}"
                                            TextColor="{StaticResource WhiteSoft}" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>

                            <Border
                                Margin="0,6,0,0"
                                Padding="12,5"
                                BackgroundColor="{StaticResource WhiteGlass}"
                                HorizontalOptions="Start"
                                StrokeShape="RoundRectangle 14"
                                StrokeThickness="0">
                                <Label
                                    FontFamily="OpenSansSemibold"
                                    FontSize="13"
                                    Text="{Binding YearlyText}"
                                    TextColor="White" />
                            </Border>

                            <!-- Next payment -->
                            <VerticalStackLayout Margin="0,14,0,0" IsVisible="{Binding HasNext}" Spacing="12">
                                <BoxView HeightRequest="1" Color="#33FFFFFF" />
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                    <Border
                                        BackgroundColor="{StaticResource WhiteGlass}"
                                        HeightRequest="40"
                                        StrokeShape="RoundRectangle 13"
                                        StrokeThickness="0"
                                        WidthRequest="40">
                                        <Label
                                            FontSize="20"
                                            HorizontalOptions="Center"
                                            Text="{Binding NextIcon}"
                                            VerticalOptions="Center" />
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1" Spacing="0" VerticalOptions="Center">
                                        <Label
                                            FontSize="12"
                                            LineBreakMode="TailTruncation"
                                            Text="{Binding NextCaption}"
                                            TextColor="{StaticResource WhiteSoft}" />
                                        <Label
                                            FontFamily="OpenSansSemibold"
                                            FontSize="15"
                                            LineBreakMode="TailTruncation"
                                            Text="{Binding NextName}"
                                            TextColor="White" />
                                    </VerticalStackLayout>
                                    <Label
                                        Grid.Column="2"
                                        FontFamily="OpenSansSemibold"
                                        FontSize="15"
                                        Text="{Binding NextAmount}"
                                        TextColor="White"
                                        VerticalOptions="Center" />
                                </Grid>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <!-- Empty state -->
                <Border IsVisible="{Binding IsEmpty}" Style="{StaticResource Card}" Padding="24,28">
                    <VerticalStackLayout Spacing="12">
                        <Label FontSize="52" HorizontalOptions="Center" Text="🗓️" />
                        <Label
                            HorizontalTextAlignment="Center"
                            Style="{StaticResource SectionTitle}"
                            Text="{l:Tr Subs_EmptyTitle}" />
                        <Label
                            HorizontalTextAlignment="Center"
                            Style="{StaticResource Secondary}"
                            Text="{l:Tr Subs_EmptyText}" />
                        <Border
                            Margin="0,10,0,0"
                            c:Touch.Command="{Binding AddSubscriptionCommand}"
                            Style="{StaticResource PrimaryButton}">
                            <Label Style="{StaticResource PrimaryButtonText}" Text="{l:Tr Subs_AddFirst}" />
                        </Border>
                        <Label
                            Padding="0,6"
                            c:Touch.Command="{Binding LoadSamplesCommand}"
                            HorizontalOptions="Center"
                            Style="{StaticResource LinkLabel}"
                            Text="{l:Tr Main_ExploreSamples}" />
                    </VerticalStackLayout>
                </Border>

                <!-- Distribution chart -->
                <comp:BreakdownCard IsVisible="{Binding HasChart}" />

                <!-- Upcoming payments -->
                <VerticalStackLayout IsVisible="{Binding HasActive}" Spacing="12">
                    <Label Style="{StaticResource SectionTitle}" Text="{l:Tr Subs_Upcoming}" />
                    <VerticalStackLayout
                        BindableLayout.ItemTemplate="{StaticResource SubscriptionRow}"
                        BindableLayout.ItemsSource="{Binding Active}"
                        Spacing="12" />
                </VerticalStackLayout>

                <!-- Paused or cancelled -->
                <VerticalStackLayout IsVisible="{Binding HasInactive}" Spacing="12">
                    <Label Style="{StaticResource SectionTitle}" Text="{l:Tr Subs_Paused}" />
                    <VerticalStackLayout
                        BindableLayout.ItemTemplate="{StaticResource SubscriptionRow}"
                        BindableLayout.ItemsSource="{Binding Inactive}"
                        Spacing="12" />
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

    </Grid>
</ContentPage>
