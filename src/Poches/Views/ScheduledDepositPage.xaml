<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Poches.Views.ScheduledDepositPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:c="clr-namespace:Poches.Controls"
    xmlns:l="clr-namespace:Poches.Localization"
    xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
    xmlns:vm="clr-namespace:Poches.ViewModels"
    x:DataType="vm:ScheduledDepositViewModel"
    ios:Page.ModalPresentationStyle="FormSheet"
    Shell.NavBarIsVisible="False"
    Shell.PresentationMode="ModalAnimated"
    SafeAreaEdges="All">

    <Grid RowDefinitions="Auto,*,Auto">
        <!-- Sheet header -->
        <Grid Padding="20,18,20,6" ColumnDefinitions="90,*,90">
            <Label
                c:Touch.Command="{Binding CancelCommand}"
                Style="{StaticResource LinkLabel}"
                Text="{l:Tr Common_Cancel}" />
            <Label Grid.Column="1" Style="{StaticResource PageTitle}" Text="{Binding Title}" />
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20,14,20,24" Spacing="22">
                <VerticalStackLayout HorizontalOptions="Center" Spacing="6">
                    <Border
                        BackgroundColor="#2610B981"
                        HeightRequest="84"
                        HorizontalOptions="Center"
                        StrokeShape="RoundRectangle 28"
                        StrokeThickness="0"
                        WidthRequest="84">
                        <Label FontSize="40" HorizontalOptions="Center" Text="🔁" VerticalOptions="Center" />
                    </Border>
                    <Label HorizontalTextAlignment="Center" Style="{StaticResource Secondary}" Text="{Binding PocketName}" />
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="8">
                    <Label Style="{StaticResource FieldLabel}" Text="{l:Tr Scheduled_Amount}" />
                    <Border Style="{StaticResource InputField}">
                        <Grid ColumnDefinitions="*,Auto">
                            <Entry Keyboard="Numeric" Placeholder="{Binding AmountPlaceholder}" Text="{Binding AmountText}" />
                            <Label
                                Grid.Column="1"
                                Style="{StaticResource Secondary}"
                                Text="{Binding Currency}"
                                VerticalOptions="Center" />
                        </Grid>
                    </Border>
                    <Label
                        Margin="4,0,0,0"
                        IsVisible="{Binding HasHint}"
                        Style="{StaticResource Caption}"
                        Text="{Binding Hint}" />
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="8">
                    <Label Style="{StaticResource FieldLabel}" Text="{l:Tr Scheduled_Every}" />
                    <Border
                        Padding="4"
                        BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceMutedLight}, Dark={StaticResource SurfaceMutedDark}}"
                        StrokeShape="RoundRectangle 16"
                        StrokeThickness="0">
                        <Grid BindableLayout.ItemsSource="{Binding Periods}" ColumnDefinitions="*,*,*,*,*">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:SelectableOption">
                                    <Grid Grid.Column="{Binding Column}" c:Touch.Command="{Binding SelectCommand}" HeightRequest="40">
                                        <Border
                                            Padding="0"
                                            IsVisible="{Binding IsSelected}"
                                            StrokeShape="RoundRectangle 12"
                                            Style="{StaticResource Card}" />
                                        <Label
                                            FontFamily="OpenSansSemibold"
                                            FontSize="12"
                                            HorizontalOptions="Center"
                                            LineBreakMode="TailTruncation"
                                            Opacity="{Binding LabelOpacity}"
                                            Text="{Binding Label}"
                                            VerticalOptions="Center" />
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </Grid>
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="8">
                    <Label Style="{StaticResource FieldLabel}" Text="{l:Tr Scheduled_Next}" />
                    <Border Style="{StaticResource InputField}">
                        <Grid ColumnDefinitions="22,*" ColumnSpacing="12">
                            <c:IconView
                                Color="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"
                                Data="{x:Static c:Icons.Calendar}"
                                VerticalOptions="Center" />
                            <DatePicker
                                Grid.Column="1"
                                Date="{Binding NextDate}"
                                Format="dddd d MMMM yyyy"
                                MinimumDate="{Binding MinimumDate}" />
                        </Grid>
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="8">
                    <Label Style="{StaticResource FieldLabel}" Text="{l:Tr Scheduled_Label}" />
                    <Border Style="{StaticResource InputField}">
                        <Entry MaxLength="60" Placeholder="{l:Tr Scheduled_DefaultNote}" Text="{Binding Note}" />
                    </Border>
                </VerticalStackLayout>

                <Border
                    Padding="16,14"
                    IsVisible="{Binding IsNew, Converter={StaticResource InvertBool}}"
                    Style="{StaticResource Card}">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <VerticalStackLayout Spacing="0" VerticalOptions="Center">
                            <Label FontSize="15" Style="{StaticResource Strong}" Text="{l:Tr Scheduled_Active}" />
                            <Label Style="{StaticResource Caption}" Text="{l:Tr Scheduled_ActiveHint}" />
                        </VerticalStackLayout>
                        <Switch Grid.Column="1" IsToggled="{Binding IsActive}" VerticalOptions="Center" />
                    </Grid>
                </Border>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Actions -->
        <VerticalStackLayout Grid.Row="2" Padding="20,8,20,16" Spacing="10">
            <Label IsVisible="{Binding HasError}" Style="{StaticResource ErrorLabel}" Text="{Binding ErrorMessage}" />
            <Border c:Touch.Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}">
                <Label Style="{StaticResource PrimaryButtonText}" Text="{l:Tr Common_Save}" />
            </Border>
            <Label
                Padding="0,8"
                c:Touch.Command="{Binding DeleteCommand}"
                FontFamily="OpenSansSemibold"
                HorizontalOptions="Center"
                IsVisible="{Binding IsNew, Converter={StaticResource InvertBool}}"
                Text="{l:Tr Scheduled_Delete}"
                TextColor="{AppThemeBinding Light={StaticResource NegativeLight}, Dark={StaticResource NegativeDark}}" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
