<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Poches.Views.EditPocketPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:c="clr-namespace:Poches.Controls"
    xmlns:comp="clr-namespace:Poches.Views.Components"
    xmlns:l="clr-namespace:Poches.Localization"
    xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
    xmlns:vm="clr-namespace:Poches.ViewModels"
    x:DataType="vm:EditPocketViewModel"
    ios:Page.ModalPresentationStyle="PageSheet"
    Shell.NavBarIsVisible="False"
    SafeAreaEdges="All"
    Shell.PresentationMode="ModalAnimated">

    <Grid RowDefinitions="Auto,*,Auto">
        <!-- Sheet header -->
        <Grid Padding="20,18,20,6" ColumnDefinitions="90,*,90">
            <Label
                c:Touch.Command="{Binding CancelCommand}"
                Style="{StaticResource LinkLabel}"
                Text="{l:Tr Common_Cancel}" />
            <Label Grid.Column="1" Style="{StaticResource PageTitle}" Text="{Binding Title}" />
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20,14,20,24" Spacing="22">

                <!-- Live preview -->
                <Border
                    BackgroundColor="{Binding Appearance.SoftColor}"
                    HeightRequest="96"
                    HorizontalOptions="Center"
                    StrokeShape="RoundRectangle 32"
                    StrokeThickness="0"
                    WidthRequest="96">
                    <Label
                        FontSize="48"
                        HorizontalOptions="Center"
                        Text="{Binding Appearance.Icon}"
                        VerticalOptions="Center" />
                </Border>

                <VerticalStackLayout Spacing="8">
                    <Label Style="{StaticResource FieldLabel}" Text="{l:Tr Edit_Name}" />
                    <Border Style="{StaticResource InputField}">
                        <Entry
                            MaxLength="40"
                            Placeholder="{l:Tr Edit_NamePlaceholder}"
                            ReturnType="Done"
                            Text="{Binding Name}" />
                    </Border>
                </VerticalStackLayout>

                <comp:AppearancePicker BindingContext="{Binding Appearance}" />

                <Border Padding="16,14" Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="12">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <Border
                                Padding="8"
                                BackgroundColor="{Binding Appearance.SoftColor}"
                                HeightRequest="38"
                                StrokeShape="RoundRectangle 12"
                                StrokeThickness="0"
                                VerticalOptions="Center"
                                WidthRequest="38">
                                <c:IconView Color="{Binding Appearance.Color}" Data="{x:Static c:Icons.Target}" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="0" VerticalOptions="Center">
                                <Label Style="{StaticResource Strong}" FontSize="15" Text="{l:Tr Edit_Goal}" />
                                <Label Style="{StaticResource Caption}" Text="{l:Tr Edit_GoalHint}" />
                            </VerticalStackLayout>
                            <Switch
                                Grid.Column="2"
                                IsToggled="{Binding HasGoal}"
                                OnColor="{Binding Appearance.Color}"
                                VerticalOptions="Center" />
                        </Grid>
                        <Border IsVisible="{Binding HasGoal}" Style="{StaticResource InputField}">
                            <Grid ColumnDefinitions="*,Auto">
                                <Entry Keyboard="Numeric" Placeholder="2000" Text="{Binding GoalText}" />
                                <Label
                                    Grid.Column="1"
                                    Style="{StaticResource Secondary}"
                                    Text="{Binding Currency}"
                                    VerticalOptions="Center" />
                            </Grid>
                        </Border>
                    </VerticalStackLayout>
                </Border>

                <VerticalStackLayout IsVisible="{Binding IsNew}" Spacing="8">
                    <Label Style="{StaticResource FieldLabel}" Text="{l:Tr Edit_InitialAmount}" />
                    <Border Style="{StaticResource InputField}">
                        <Grid ColumnDefinitions="*,Auto">
                            <Entry Keyboard="Numeric" Placeholder="0" Text="{Binding InitialAmountText}" />
                            <Label
                                Grid.Column="1"
                                Style="{StaticResource Secondary}"
                                Text="{Binding Currency}"
                                VerticalOptions="Center" />
                        </Grid>
                    </Border>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Actions -->
        <VerticalStackLayout Grid.Row="2" Padding="20,8,20,16" Spacing="10">
            <Label IsVisible="{Binding HasError}" Style="{StaticResource ErrorLabel}" Text="{Binding ErrorMessage}" />
            <Border
                Background="{Binding Appearance.Brush}"
                c:Touch.Command="{Binding SaveCommand}"
                Style="{StaticResource PrimaryButton}">
                <Label Style="{StaticResource PrimaryButtonText}" Text="{l:Tr Common_Save}" />
            </Border>
            <Label
                Padding="0,8"
                c:Touch.Command="{Binding DeleteCommand}"
                FontFamily="OpenSansSemibold"
                HorizontalOptions="Center"
                IsVisible="{Binding IsNew, Converter={StaticResource InvertBool}}"
                Text="{l:Tr Edit_Delete}"
                TextColor="{AppThemeBinding Light={StaticResource NegativeLight}, Dark={StaticResource NegativeDark}}" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
