<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Poches.Views.EditPocketPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:c="clr-namespace:Poches.Controls"
    xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
    xmlns:vm="clr-namespace:Poches.ViewModels"
    x:DataType="vm:EditPocketViewModel"
    ios:Page.ModalPresentationStyle="PageSheet"
    Shell.NavBarIsVisible="False"
    SafeAreaEdges="All"
    Shell.PresentationMode="ModalAnimated">

    <Grid RowDefinitions="Auto,*,Auto">
        <!-- Sheet header -->
        <Grid Padding="20,18,20,6" ColumnDefinitions="90,*,90">
            <Label
                c:Touch.Command="{Binding CancelCommand}"
                Style="{StaticResource LinkLabel}"
                Text="Annuler" />
            <Label Grid.Column="1" Style="{StaticResource PageTitle}" Text="{Binding Title}" />
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20,14,20,24" Spacing="22">

                <!-- Live preview -->
                <Border
                    BackgroundColor="{Binding SelectedSoftColor}"
                    HeightRequest="96"
                    HorizontalOptions="Center"
                    StrokeShape="RoundRectangle 32"
                    StrokeThickness="0"
                    WidthRequest="96">
                    <Label
                        FontSize="48"
                        HorizontalOptions="Center"
                        Text="{Binding SelectedIcon}"
                        VerticalOptions="Center" />
                </Border>

                <VerticalStackLayout Spacing="8">
                    <Label Style="{StaticResource FieldLabel}" Text="NOM" />
                    <Border Style="{StaticResource InputField}">
                        <Entry
                            MaxLength="40"
                            Placeholder="Ex : Vacances, Épargne, Voiture…"
                            ReturnType="Done"
                            Text="{Binding Name}" />
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="8">
                    <Label Style="{StaticResource FieldLabel}" Text="ICÔNE" />
                    <Border Padding="8,10" Style="{StaticResource Card}">
                        <Grid
                            BindableLayout.ItemsSource="{Binding IconOptions}"
                            ColumnDefinitions="*,*,*,*,*,*"
                            RowDefinitions="Auto,Auto,Auto,Auto"
                            RowSpacing="6">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:SelectableOption">
                                    <Grid
                                        Grid.Row="{Binding Row}"
                                        Grid.Column="{Binding Column}"
                                        c:Touch.Command="{Binding SelectCommand}"
                                        HeightRequest="50"
                                        HorizontalOptions="Center"
                                        WidthRequest="50">
                                        <Border
                                            BackgroundColor="{Binding AccentSoft}"
                                            IsVisible="{Binding IsSelected}"
                                            Stroke="{Binding Accent}"
                                            StrokeShape="RoundRectangle 15"
                                            StrokeThickness="2" />
                                        <Label
                                            FontSize="26"
                                            HorizontalOptions="Center"
                                            Text="{Binding Value}"
                                            VerticalOptions="Center" />
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </Grid>
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="8">
                    <Label Style="{StaticResource FieldLabel}" Text="COULEUR" />
                    <Border Padding="8,12" Style="{StaticResource Card}">
                        <Grid
                            BindableLayout.ItemsSource="{Binding ColorOptions}"
                            ColumnDefinitions="*,*,*,*,*,*"
                            RowDefinitions="Auto,Auto"
                            RowSpacing="10">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:SelectableOption">
                                    <Grid
                                        Grid.Row="{Binding Row}"
                                        Grid.Column="{Binding Column}"
                                        c:Touch.Command="{Binding SelectCommand}"
                                        HeightRequest="46"
                                        HorizontalOptions="Center"
                                        WidthRequest="46">
                                        <Ellipse
                                            IsVisible="{Binding IsSelected}"
                                            Stroke="{Binding Color}"
                                            StrokeThickness="2.5" />
                                        <Ellipse
                                            Fill="{Binding Color}"
                                            HeightRequest="34"
                                            HorizontalOptions="Center"
                                            VerticalOptions="Center"
                                            WidthRequest="34" />
                                        <c:IconView
                                            Color="White"
                                            Data="{x:Static c:Icons.Check}"
                                            HeightRequest="18"
                                            IsVisible="{Binding IsSelected}"
                                            StrokeWidth="2.6"
                                            WidthRequest="18" />
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </Grid>
                    </Border>
                </VerticalStackLayout>

                <Border Padding="16,14" Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="12">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <Border
                                Padding="8"
                                BackgroundColor="{Binding SelectedSoftColor}"
                                HeightRequest="38"
                                StrokeShape="RoundRectangle 12"
                                StrokeThickness="0"
                                VerticalOptions="Center"
                                WidthRequest="38">
                                <c:IconView Color="{Binding SelectedColor}" Data="{x:Static c:Icons.Target}" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="0" VerticalOptions="Center">
                                <Label Style="{StaticResource Strong}" FontSize="15" Text="Objectif d'épargne" />
                                <Label Style="{StaticResource Caption}" Text="Suis ta progression vers un montant cible" />
                            </VerticalStackLayout>
                            <Switch
                                Grid.Column="2"
                                IsToggled="{Binding HasGoal}"
                                OnColor="{Binding SelectedColor}"
                                VerticalOptions="Center" />
                        </Grid>
                        <Border IsVisible="{Binding HasGoal}" Style="{StaticResource InputField}">
                            <Grid ColumnDefinitions="*,Auto">
                                <Entry Keyboard="Numeric" Placeholder="2 000" Text="{Binding GoalText}" />
                                <Label
                                    Grid.Column="1"
                                    Style="{StaticResource Secondary}"
                                    Text="{Binding Currency}"
                                    VerticalOptions="Center" />
                            </Grid>
                        </Border>
                    </VerticalStackLayout>
                </Border>

                <VerticalStackLayout IsVisible="{Binding IsNew}" Spacing="8">
                    <Label Style="{StaticResource FieldLabel}" Text="MONTANT DE DÉPART (FACULTATIF)" />
                    <Border Style="{StaticResource InputField}">
                        <Grid ColumnDefinitions="*,Auto">
                            <Entry Keyboard="Numeric" Placeholder="0" Text="{Binding InitialAmountText}" />
                            <Label
                                Grid.Column="1"
                                Style="{StaticResource Secondary}"
                                Text="{Binding Currency}"
                                VerticalOptions="Center" />
                        </Grid>
                    </Border>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Actions -->
        <VerticalStackLayout Grid.Row="2" Padding="20,8,20,16" Spacing="10">
            <Label IsVisible="{Binding HasError}" Style="{StaticResource ErrorLabel}" Text="{Binding ErrorMessage}" />
            <Border
                Background="{Binding SelectedBrush}"
                c:Touch.Command="{Binding SaveCommand}"
                Style="{StaticResource PrimaryButton}">
                <Label Style="{StaticResource PrimaryButtonText}" Text="Enregistrer" />
            </Border>
            <Label
                Padding="0,8"
                c:Touch.Command="{Binding DeleteCommand}"
                FontFamily="OpenSansSemibold"
                HorizontalOptions="Center"
                IsVisible="{Binding IsNew, Converter={StaticResource InvertBool}}"
                Text="Supprimer la poche"
                TextColor="{AppThemeBinding Light={StaticResource NegativeLight}, Dark={StaticResource NegativeDark}}" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
