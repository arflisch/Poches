<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Poches.Views.StatisticsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:c="clr-namespace:Poches.Controls"
    xmlns:l="clr-namespace:Poches.Localization"
    xmlns:vm="clr-namespace:Poches.ViewModels"
    x:DataType="vm:StatisticsViewModel"
    Shell.NavBarIsVisible="False"
    Shell.TabBarIsVisible="False"
    SafeAreaEdges="None">

    <Grid RowDefinitions="Auto,*" SafeAreaEdges="Container,Container,Container,None" Style="{StaticResource PageColumn}">
        <!-- Top bar -->
        <Grid Padding="20,8,20,6" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
            <Border
                c:Touch.Command="{Binding GoBackCommand}"
                Style="{StaticResource IconButton}"
                SemanticProperties.Description="{l:Tr Common_Back}">
                <c:IconView Color="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" Data="{x:Static c:Icons.ChevronLeft}" />
            </Border>
            <Label Grid.Column="1" Style="{StaticResource PageTitle}" Text="{l:Tr Pro_StatsTitle}" />
            <BoxView Grid.Column="2" WidthRequest="44" Color="Transparent" />
        </Grid>

        <ScrollView Grid.Row="1" SafeAreaEdges="None">
            <VerticalStackLayout Padding="20,8,20,64" Spacing="18">

                <!-- Phone: one block above the other. iPad or wide window: side by side. -->
                <c:TwoPane Spacing="18">
                    <c:TwoPane.Start>
                        <VerticalStackLayout Spacing="18">
                            <Border IsVisible="{Binding IsEmpty}" Padding="24,28" Style="{StaticResource Card}">
                                <VerticalStackLayout Spacing="10">
                                    <Label FontSize="44" HorizontalOptions="Center" Text="📈" />
                                    <Label HorizontalTextAlignment="Center" Style="{StaticResource Secondary}" Text="{l:Tr Stats_Empty}" />
                                </VerticalStackLayout>
                            </Border>

                            <!-- Saving pace -->
                            <Border
                                Background="{StaticResource HeroGradient}"
                                IsVisible="{Binding HasActivity}"
                                Shadow="{StaticResource FloatingShadow}"
                                StrokeShape="RoundRectangle 28"
                                StrokeThickness="0">
                                <VerticalStackLayout Padding="24,22" Spacing="4">
                                    <Label FontSize="15" Text="{l:Tr Stats_Average}" TextColor="{StaticResource WhiteSoft}" />
                                    <Label FontFamily="OpenSansSemibold" FontSize="32" Text="{Binding AverageText}" TextColor="White" />
                                    <Grid Margin="0,10,0,0" ColumnDefinitions="*,*" ColumnSpacing="12">
                                        <VerticalStackLayout Spacing="0">
                                            <Label FontSize="12" Text="{l:Tr Stats_Deposits}" TextColor="{StaticResource WhiteSoft}" />
                                            <Label FontFamily="OpenSansSemibold" FontSize="16" Text="{Binding DepositsText}" TextColor="White" />
                                        </VerticalStackLayout>
                                        <VerticalStackLayout Grid.Column="1" Spacing="0">
                                            <Label FontSize="12" Text="{l:Tr Stats_Withdrawals}" TextColor="{StaticResource WhiteSoft}" />
                                            <Label FontFamily="OpenSansSemibold" FontSize="16" Text="{Binding WithdrawalsText}" TextColor="White" />
                                        </VerticalStackLayout>
                                    </Grid>
                                </VerticalStackLayout>
                            </Border>

                            <!-- Total over time -->
                            <Border IsVisible="{Binding HasActivity}" Padding="18,16" Style="{StaticResource Card}">
                                <VerticalStackLayout Spacing="8">
                                    <Label Style="{StaticResource SectionTitle}" Text="{l:Tr Stats_Evolution}" />
                                    <Label Style="{StaticResource Caption}" Text="{Binding EvolutionChange}" />
                                    <c:SparklineView HeightRequest="130" LineColor="{StaticResource Primary}" Points="{Binding Evolution}" />
                                    <Grid ColumnDefinitions="*,*">
                                        <Label Style="{StaticResource Caption}" Text="{Binding FirstMonth}" />
                                        <Label Grid.Column="1" HorizontalTextAlignment="End" Style="{StaticResource Caption}" Text="{Binding LastMonth}" />
                                    </Grid>
                                </VerticalStackLayout>
                            </Border>
                        </VerticalStackLayout>
                    </c:TwoPane.Start>
                    <c:TwoPane.End>
                        <VerticalStackLayout Spacing="18" IsVisible="{Binding HasActivity}">
                            <!-- Net savings per month -->
                            <Border IsVisible="{Binding HasActivity}" Padding="18,16" Style="{StaticResource Card}">
                                <VerticalStackLayout Spacing="8">
                                    <Label Style="{StaticResource SectionTitle}" Text="{l:Tr Stats_PerMonth}" />
                                    <Label Style="{StaticResource Caption}" Text="{l:Tr Stats_PerMonthHint}" />
                                    <c:BarChartView
                                        HeightRequest="150"
                                        LabelColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"
                                        Labels="{Binding MonthLabels}"
                                        Values="{Binding MonthlyNet}" />
                                </VerticalStackLayout>
                            </Border>

                            <!-- Goals -->
                            <VerticalStackLayout IsVisible="{Binding HasGoals}" Spacing="12">
                                <Label Style="{StaticResource SectionTitle}" Text="{l:Tr Stats_Goals}" />
                                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Goals}" Spacing="12">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="vm:GoalItemViewModel">
                                            <Border Padding="14" Style="{StaticResource Card}">
                                                <Grid ColumnDefinitions="44,*" ColumnSpacing="14">
                                                    <Border
                                                        BackgroundColor="{Binding SoftColor}"
                                                        HeightRequest="44"
                                                        StrokeShape="RoundRectangle 14"
                                                        StrokeThickness="0"
                                                        VerticalOptions="Start"
                                                        WidthRequest="44">
                                                        <Label FontSize="21" HorizontalOptions="Center" Text="{Binding Icon}" VerticalOptions="Center" />
                                                    </Border>
                                                    <VerticalStackLayout Grid.Column="1" Spacing="6">
                                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                                            <Label LineBreakMode="TailTruncation" Style="{StaticResource Strong}" Text="{Binding Name}" />
                                                            <Label Grid.Column="1" Style="{StaticResource Caption}" Text="{Binding AmountsText}" VerticalOptions="Center" />
                                                        </Grid>
                                                        <c:ProgressPill
                                                            FillColor="{Binding Color}"
                                                            HeightRequest="6"
                                                            Progress="{Binding Progress}"
                                                            TrackColor="{Binding SoftColor}" />
                                                        <Label Style="{StaticResource Caption}" Text="{Binding StatusText}" />
                                                    </VerticalStackLayout>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </c:TwoPane.End>
                </c:TwoPane>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
