<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Poches.Views.BackupPasswordPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:c="clr-namespace:Poches.Controls"
    xmlns:l="clr-namespace:Poches.Localization"
    xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
    xmlns:vm="clr-namespace:Poches.ViewModels"
    x:DataType="vm:BackupPasswordViewModel"
    ios:Page.ModalPresentationStyle="FormSheet"
    Shell.NavBarIsVisible="False"
    SafeAreaEdges="All">

    <Grid RowDefinitions="Auto,*,Auto">
        <!-- Sheet header -->
        <Label
            Padding="20,18,20,6"
            c:Touch.Command="{Binding CancelCommand}"
            HorizontalOptions="Start"
            Style="{StaticResource LinkLabel}"
            Text="{l:Tr Common_Cancel}" />

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20,6,20,24" Spacing="20">
                <Border
                    Padding="20"
                    BackgroundColor="#264F46E5"
                    HeightRequest="84"
                    HorizontalOptions="Center"
                    StrokeShape="RoundRectangle 28"
                    StrokeThickness="0"
                    WidthRequest="84">
                    <c:IconView
                        Color="{StaticResource Primary}"
                        Data="{x:Static c:Icons.Lock}"
                        HeightRequest="44"
                        WidthRequest="44" />
                </Border>

                <VerticalStackLayout Spacing="8">
                    <Label
                        FontSize="24"
                        HorizontalTextAlignment="Center"
                        Style="{StaticResource SectionTitle}"
                        Text="{Binding Title}" />
                    <Label
                        HorizontalTextAlignment="Center"
                        Style="{StaticResource Secondary}"
                        Text="{Binding Explanation}" />
                </VerticalStackLayout>

                <!-- Irreversible: say it plainly before the user picks a password. -->
                <Border
                    Padding="14,12"
                    BackgroundColor="#1FF59E0B"
                    IsVisible="{Binding IsCreate}"
                    StrokeShape="RoundRectangle 16"
                    StrokeThickness="0">
                    <Label
                        FontSize="14"
                        Text="{l:Tr Password_Warning}"
                        TextColor="{AppThemeBinding Light={StaticResource DueSoonLight}, Dark={StaticResource DueSoonDark}}" />
                </Border>

                <VerticalStackLayout Spacing="8">
                    <Label Style="{StaticResource FieldLabel}" Text="{l:Tr Password_Label}" />
                    <Border Style="{StaticResource InputField}">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <Entry
                                x:Name="PasswordEntry"
                                IsPassword="{Binding IsHidden}"
                                IsSpellCheckEnabled="False"
                                Keyboard="Plain"
                                IsTextPredictionEnabled="False"
                                ReturnCommand="{Binding ConfirmCommand}"
                                Text="{Binding Password}" />
                            <Border
                                Grid.Column="1"
                                Padding="8"
                                c:Touch.Command="{Binding ToggleVisibilityCommand}"
                                BackgroundColor="Transparent"
                                HeightRequest="38"
                                StrokeThickness="0"
                                VerticalOptions="Center"
                                WidthRequest="38"
                                SemanticProperties.Description="{l:Tr Password_Show}">
                                <c:IconView
                                    Color="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"
                                    Data="{Binding VisibilityIcon}" />
                            </Border>
                        </Grid>
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout IsVisible="{Binding IsCreate}" Spacing="8">
                    <Label Style="{StaticResource FieldLabel}" Text="{l:Tr Password_ConfirmLabel}" />
                    <Border Style="{StaticResource InputField}">
                        <Entry
                            IsPassword="{Binding IsHidden}"
                            IsSpellCheckEnabled="False"
                            Keyboard="Plain"
                            IsTextPredictionEnabled="False"
                            ReturnCommand="{Binding ConfirmCommand}"
                            Text="{Binding Confirmation}" />
                    </Border>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Actions -->
        <VerticalStackLayout Grid.Row="2" Padding="20,8,20,16" Spacing="10">
            <Label IsVisible="{Binding HasError}" Style="{StaticResource ErrorLabel}" Text="{Binding ErrorMessage}" />
            <Border c:Touch.Command="{Binding ConfirmCommand}" Style="{StaticResource PrimaryButton}">
                <Grid>
                    <Label
                        IsVisible="{Binding IsBusy, Converter={StaticResource InvertBool}}"
                        Style="{StaticResource PrimaryButtonText}"
                        Text="{Binding ConfirmText}" />
                    <ActivityIndicator
                        HeightRequest="24"
                        IsRunning="{Binding IsBusy}"
                        IsVisible="{Binding IsBusy}"
                        WidthRequest="24"
                        Color="White" />
                </Grid>
            </Border>
        </VerticalStackLayout>
    </Grid>
</ContentPage>
