<?xml version="1.0" encoding="utf-8" ?>
<VerticalStackLayout
    x:Class="Poches.Views.Components.AppearancePicker"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:c="clr-namespace:Poches.Controls"
    xmlns:l="clr-namespace:Poches.Localization"
    xmlns:vm="clr-namespace:Poches.ViewModels"
    x:DataType="vm:AppearanceSelection"
    Spacing="22">

    <VerticalStackLayout Spacing="8">
        <Label Style="{StaticResource FieldLabel}" Text="{l:Tr Edit_Icon}" />
        <Border Padding="8,10" Style="{StaticResource Card}">
            <Grid
                BindableLayout.ItemsSource="{Binding IconOptions}"
                ColumnDefinitions="*,*,*,*,*,*"
                RowDefinitions="Auto,Auto,Auto,Auto"
                RowSpacing="6">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vm:SelectableOption">
                        <Grid
                            Grid.Row="{Binding Row}"
                            Grid.Column="{Binding Column}"
                            c:Touch.Command="{Binding SelectCommand}"
                            HeightRequest="50"
                            HorizontalOptions="Center"
                            WidthRequest="50">
                            <Border
                                BackgroundColor="{Binding AccentSoft}"
                                IsVisible="{Binding IsSelected}"
                                Stroke="{Binding Accent}"
                                StrokeShape="RoundRectangle 15"
                                StrokeThickness="2" />
                            <Label
                                FontSize="26"
                                HorizontalOptions="Center"
                                Text="{Binding Value}"
                                VerticalOptions="Center" />
                        </Grid>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </Grid>
        </Border>
    </VerticalStackLayout>

    <VerticalStackLayout Spacing="8">
        <Label Style="{StaticResource FieldLabel}" Text="{l:Tr Edit_Color}" />
        <Border Padding="8,12" Style="{StaticResource Card}">
            <Grid
                BindableLayout.ItemsSource="{Binding ColorOptions}"
                ColumnDefinitions="*,*,*,*,*,*"
                RowDefinitions="Auto,Auto"
                RowSpacing="10">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vm:SelectableOption">
                        <Grid
                            Grid.Row="{Binding Row}"
                            Grid.Column="{Binding Column}"
                            c:Touch.Command="{Binding SelectCommand}"
                            HeightRequest="46"
                            HorizontalOptions="Center"
                            WidthRequest="46">
                            <Ellipse
                                IsVisible="{Binding IsSelected}"
                                Stroke="{Binding Color}"
                                StrokeThickness="2.5" />
                            <Ellipse
                                Fill="{Binding Color}"
                                HeightRequest="34"
                                HorizontalOptions="Center"
                                VerticalOptions="Center"
                                WidthRequest="34" />
                            <c:IconView
                                Color="White"
                                Data="{x:Static c:Icons.Check}"
                                HeightRequest="18"
                                IsVisible="{Binding IsSelected}"
                                StrokeWidth="2.6"
                                WidthRequest="18" />
                        </Grid>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </Grid>
        </Border>
    </VerticalStackLayout>
</VerticalStackLayout>
