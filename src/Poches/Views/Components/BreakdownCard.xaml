<?xml version="1.0" encoding="utf-8" ?>
<Border
    x:Class="Poches.Views.Components.BreakdownCard"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:c="clr-namespace:Poches.Controls"
    xmlns:l="clr-namespace:Poches.Localization"
    xmlns:vm="clr-namespace:Poches.ViewModels"
    x:DataType="vm:IBreakdown"
    Style="{StaticResource Card}">
    <VerticalStackLayout Spacing="16">
        <Label Style="{StaticResource SectionTitle}" Text="{l:Tr Main_Distribution}" />
        <Grid ColumnDefinitions="140,*" ColumnSpacing="18">
            <Grid HeightRequest="140" WidthRequest="140">
                <c:DonutChartView
                    Slices="{Binding ChartSlices}"
                    Thickness="18"
                    TrackColor="{AppThemeBinding Light={StaticResource SurfaceMutedLight}, Dark={StaticResource SurfaceMutedDark}}" />
                <VerticalStackLayout HorizontalOptions="Center" Spacing="-4" VerticalOptions="Center">
                    <Label
                        FontFamily="OpenSansSemibold"
                        FontSize="28"
                        HorizontalTextAlignment="Center"
                        Text="{Binding ChartCenterValue}" />
                    <Label
                        HorizontalTextAlignment="Center"
                        Style="{StaticResource Caption}"
                        Text="{Binding ChartCenterLabel}" />
                </VerticalStackLayout>
            </Grid>
            <VerticalStackLayout
                Grid.Column="1"
                BindableLayout.ItemsSource="{Binding Legend}"
                Spacing="12"
                VerticalOptions="Center">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vm:LegendItem">
                        <Grid ColumnDefinitions="10,*,Auto" ColumnSpacing="10">
                            <Ellipse
                                Fill="{Binding Color}"
                                HeightRequest="10"
                                VerticalOptions="Center"
                                WidthRequest="10" />
                            <Label
                                Grid.Column="1"
                                FontSize="13.5"
                                LineBreakMode="TailTruncation"
                                Text="{Binding Name}" />
                            <Label
                                Grid.Column="2"
                                FontFamily="OpenSansSemibold"
                                FontSize="13.5"
                                Text="{Binding Percent}" />
                        </Grid>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
        </Grid>
    </VerticalStackLayout>
</Border>
