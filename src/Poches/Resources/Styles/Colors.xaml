<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Note: for Android see also Platforms/Android/Resources/values/colors.xml -->

    <!-- Brand -->
    <Color x:Key="Primary">#4F46E5</Color>
    <Color x:Key="PrimaryDarkMode">#818CF8</Color>
    <Color x:Key="Violet">#7C3AED</Color>
    <Color x:Key="Magenta">#A21CAF</Color>

    <!-- Semantic -->
    <Color x:Key="PositiveLight">#059669</Color>
    <Color x:Key="PositiveDark">#34D399</Color>
    <Color x:Key="NegativeLight">#E11D48</Color>
    <Color x:Key="NegativeDark">#FB7185</Color>

    <!-- Surfaces -->
    <Color x:Key="PageLight">#F4F5FA</Color>
    <Color x:Key="PageDark">#0B0D12</Color>
    <Color x:Key="SurfaceLight">#FFFFFF</Color>
    <Color x:Key="SurfaceDark">#161922</Color>
    <Color x:Key="SurfaceMutedLight">#ECEEF5</Color>
    <Color x:Key="SurfaceMutedDark">#222633</Color>
    <Color x:Key="DividerLight">#E2E8F0</Color>
    <Color x:Key="DividerDark">#2A2F3C</Color>

    <!-- Text -->
    <Color x:Key="TextPrimaryLight">#0F172A</Color>
    <Color x:Key="TextPrimaryDark">#F1F5F9</Color>
    <Color x:Key="TextSecondaryLight">#64748B</Color>
    <Color x:Key="TextSecondaryDark">#94A3B8</Color>
    <Color x:Key="TextTertiaryLight">#94A3B8</Color>
    <Color x:Key="TextTertiaryDark">#5B6475</Color>

    <Color x:Key="White">White</Color>
    <Color x:Key="WhiteSoft">#D9FFFFFF</Color>
    <Color x:Key="WhiteGlass">#26FFFFFF</Color>

    <LinearGradientBrush x:Key="HeroGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#4338CA" Offset="0" />
        <GradientStop Color="#6D28D9" Offset="0.6" />
        <GradientStop Color="#A21CAF" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="SubscriptionsGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#0F766E" Offset="0" />
        <GradientStop Color="#0E7490" Offset="0.55" />
        <GradientStop Color="#4338CA" Offset="1" />
    </LinearGradientBrush>

    <!-- Buttons of the fixed costs tab: the gradient of its card, laid out horizontally. -->
    <LinearGradientBrush x:Key="ChargesAccentGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#0F766E" Offset="0" />
        <GradientStop Color="#0E7490" Offset="0.55" />
        <GradientStop Color="#4338CA" Offset="1" />
    </LinearGradientBrush>

    <Color x:Key="DueSoonLight">#D97706</Color>
    <Color x:Key="DueSoonDark">#FBBF24</Color>

    <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#4F46E5" Offset="0" />
        <GradientStop Color="#7C3AED" Offset="1" />
    </LinearGradientBrush>
</ResourceDictionary>
